export { Palette } from "std-widgets.slint";
export { Theme, I18n } from "chrome.slint";
import { Button, LineEdit, TextEdit, CheckBox, Switch, Slider, SpinBox, ListView, ScrollView, Palette, AboutSlint } from "std-widgets.slint";
import { AppWindow, TitleBar, IconButton, Theme, I18n, SettingRow, SettingsSelect, StepperButton, HintSurface, BatchActionButton, ToastBar, ElevationShadow } from "chrome.slint";

export struct NavItem { id: int, name: string }
export struct ScopeNode { id: int, parent: int, label: string, depth: int, state: int }
export struct Item { checked: bool, id: int, name: string, detail: string, tooltip-path: string, tooltip-notes: string, kind: int, icon: image, drag-icon: image }
export struct DestinationNode { id: int, parent: int, name: string, expanded: bool }
export struct AppOption { name: string, aumid: string }
export struct DiscoverOption { checked: bool, index: int, name: string, detail: string, kind: int }
export struct BrokenOption { id: int, name: string, target: string, reason: string, relocatable: bool }
export struct NoticeItem { name: string, version: string, license: string, detail: string }

component PixelWidthInput inherits Rectangle {
    in-out property <int> value: 1;
    in property <bool> enabled: true;
    callback edited;
    property <bool> invalid;
    width: 44px; height: 32px; border-radius: Theme.radius-sm;
    background: Palette.control-background; border-width: 1px;
    border-color: invalid ? Theme.danger : input.has-focus ? Palette.accent-background : Theme.stroke;
    forward-focus: input;
    accessible-role: text-input;
    accessible-label: I18n.en ? "Edge strip width (physical pixels)" : "露边宽度（物理像素）";
    accessible-enabled: enabled;
    accessible-value <=> input.text;
    accessible-action-set-value(v) => { input.text = v; root.validate(); }
    changed value => { input.text = root.value; root.invalid = false; }
    changed enabled => { if !root.enabled { input.text = root.value; root.invalid = false; } }
    function validate() {
        root.invalid = !input.text.is-float() || input.text.to-float() < 1 || input.text.to-float() > 12 || floor(input.text.to-float()) != input.text.to-float();
        if !root.invalid { root.value = input.text.to-float(); root.edited(); }
    }
    input := TextInput {
        x: 4px; width: parent.width - 8px; height: parent.height;
        enabled: root.enabled; text: root.value; input-type: number; single-line: true;
        horizontal-alignment: center; vertical-alignment: center; color: Palette.foreground;
        edited => { root.validate(); }
        changed has-focus => { if !self.has-focus { self.text = root.value; root.invalid = false; } }
    }
    Tooltip { HintSurface { title: root.invalid ? (I18n.en ? "Enter an integer from 1 to 12" : "请输入 1–12 的整数") : (I18n.en ? "1–12 physical pixels" : "1–12 个物理像素"); } }
}

component Tile inherits Rectangle {
    in property <Item> item;
    in property <[NavItem]> destinations;
    in property <bool> selected;
    in property <bool> keyboard-focused;
    in property <bool> sortable;
    in property <bool> double-click;
    in property <bool> list-mode;
    in property <length> icon-size: 36px;
    in property <bool> search-result;
    in property <bool> batch-mode;
    callback action(int);
    callback launch;
    callback select;
    callback edit;
    callback open-menu;
    callback change-icon;
    callback convert-path(bool);
    callback remove;
    callback move(int);
    callback move-to(int);
    pure callback make-drag() -> data-transfer;
    callback can-drop(data-transfer) -> bool;
    callback drop-before(data-transfer, bool) -> bool;
    property <bool> insert-after;
    property <color> kind-tint: item.kind == 2 ? #b68422 : item.kind == 3 ? #278879 : item.kind == 5 ? #8065b9 : Palette.accent-background;
    property <image> kind-fallback-icon: item.kind == 2 ? @image-url("icons/folder.svg") : item.kind == 3 ? @image-url("icons/web.svg") : item.kind == 1 ? @image-url("icons/file.svg") : item.kind == 5 ? @image-url("icons/app.svg") : @image-url("icons/program.svg");
    border-radius: Theme.radius-lg;
    opacity: tile-drag.dragging ? 0.4 : 1;
    background: (root.batch-mode && item.checked) || (root.search-result && selected) ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    border-width: (root.keyboard-focused && root.selected && !root.search-result) || (root.batch-mode && item.checked) ? 1.5px : 0px;
    border-color: root.keyboard-focused && root.selected && !root.search-result ? Palette.accent-background : Palette.accent-background.with-alpha(0.5);
    animate background, border-color, opacity { duration: 120ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.batch-mode ? (item.checked ? (I18n.en ? "Selected " : "已选 ") : (I18n.en ? "Unselected " : "未选 ")) + item.name : item.name;
    accessible-action-default => { root.launch(); }
    forward-focus: key;
    drop := DropArea {
        enabled: root.sortable;
        can-drop(event) => { root.insert-after = root.list-mode ? event.position.y > self.height / 2 : event.position.x > self.width / 2; return root.can-drop(event.data) ? DragAction.move : DragAction.none; }
        dropped(event) => { return root.drop-before(event.data,root.list-mode ? event.position.y > self.height / 2 : event.position.x > self.width / 2) ? DragAction.move : DragAction.none; }
        tile-drag := DragArea {
            enabled: !root.search-result && root.sortable;
            drag-image: root.item.drag-icon.width > 0 ? root.item.drag-icon : root.kind-fallback-icon; drag-image-offset-x: 18; drag-image-offset-y: 18;
            allow-move: true;
            data: root.make-drag();
            Rectangle {

                if !root.list-mode: VerticalLayout {
                    padding: 6px; spacing: 4px; alignment: center;
                    HorizontalLayout { alignment: center;
                        Rectangle { width: root.icon-size; height: root.icon-size; border-radius: Theme.radius-lg;
                            background: item.icon.width > 0 ? transparent : Theme.surface.mix(root.kind-tint, 0.87);
                            Image { x: item.icon.width > 0 ? 0px : 6px; y: self.x; width: item.icon.width > 0 ? root.icon-size : root.icon-size - 12px; height: self.width;
                                source: item.icon.width > 0 ? item.icon : root.kind-fallback-icon; colorize: item.icon.width > 0 ? #0000 : root.kind-tint;
                            }
                        }
                    }
                    Text { text: item.name; color: Palette.foreground; font-size: 12px; horizontal-alignment: center; vertical-alignment: top; wrap: word-wrap; overflow: elide; height: 34px; }
                }
                if root.list-mode: HorizontalLayout {
                    padding-top: 12px; padding-bottom: 12px; padding-right: 12px; padding-left: root.batch-mode ? 36px : 12px; spacing: 12px;
                    Rectangle { width: 28px; height: 28px; border-radius: Theme.radius-md;
                        background: item.icon.width > 0 ? transparent : Theme.surface.mix(root.kind-tint, 0.87);
                        Image { x: item.icon.width > 0 ? 0px : 5px; y: self.x; width: item.icon.width > 0 ? 28px : 18px; height: self.width;
                            source: item.icon.width > 0 ? item.icon : root.kind-fallback-icon; colorize: item.icon.width > 0 ? #0000 : root.kind-tint;
                        }
                    }
                    VerticalLayout { spacing: 3px;
                        Text { text: item.name; color: Palette.foreground; overflow: elide; }
                        Text { text: item.detail; color: Palette.alternate-foreground; font-size: 12px; overflow: elide; }
                    }
                }
                key := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Return { root.launch(); return accept; }
                        if !root.batch-mode && event.text == Key.F2 { root.edit(); return accept; }
                        return reject;
                    }
                }
                touch := TouchArea {
                    Tooltip { HintSurface { title: root.item.name; detail: root.item.tooltip-path; notes: root.item.tooltip-notes; } }
                    clicked => { key.focus(); root.select(); if root.batch-mode || !root.double-click { root.launch(); } }
                    double-clicked => { if !root.batch-mode && root.double-click { root.launch(); } }
                    pointer-event(event) => {
                        if !root.batch-mode && event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                            key.focus(); root.select(); root.open-menu();
                        }
                    }
                }
            }
        }
    }

    if root.batch-mode: Rectangle {
        x: root.list-mode ? 10px : 6px; y: root.list-mode ? (parent.height - 16px) / 2 : 6px; width: 16px; height: 16px;
        accessible-role: checkbox; accessible-label: root.item.name; accessible-checked: root.item.checked; accessible-action-default => { root.launch(); }
        border-radius: Theme.radius-sm; border-width: 1px;
        border-color: root.item.checked || touch.has-hover ? Palette.accent-background : Theme.stroke;
        background: root.item.checked ? Palette.accent-background : Theme.surface;
        animate background, border-color { duration: 120ms; easing: ease-out; }
        if root.item.checked: Image { x: 2px; y: 2px; width: 12px; height: 12px; source: @image-url("icons/check.svg"); colorize: Palette.accent-foreground; accessible-role: none; }
    }
    if drop.has-drag: Rectangle { x: root.list-mode ? 6px : root.insert-after ? parent.width - 2px : 0px; y: root.list-mode ? (root.insert-after ? parent.height - 2px : 0px) : 6px; height: root.list-mode ? 2px : parent.height - 12px; width: root.list-mode ? parent.width - 12px : 2px; border-radius: 1px; background: Palette.accent-background; }
}

component NavNode inherits Rectangle {
    in property <NavItem> node;
    in property <length> external-x: -1px;
    in property <length> external-y: -1px;
    in property <bool> external-drag;
    callback external-hit(int);
    property <bool> external-inside: external-drag && external-x >= self.absolute-position.x && external-x < self.absolute-position.x + self.width && external-y >= self.absolute-position.y && external-y < self.absolute-position.y + self.height;
    changed external-inside => { root.external-hit(self.external-inside ? root.node.id : -root.node.id); }

    in property <bool> active;
    in property <bool> group;
    in property <[NavItem]> groups;
    in property <bool> hover-switch;
    in property <int> hover-delay;
    callback select;
    callback open-menu;
    callback action(int, int);
    pure callback drag-data() -> data-transfer;
    callback can-drop(data-transfer) -> bool;
    callback drop-data(data-transfer, bool) -> bool;
    property <bool> insert-after;
    preferred-width: max(72px, nav-label.preferred-width + 24px);
    preferred-height: max(38px, nav-label.preferred-height + 16px);
    border-radius: Theme.radius-md;
    background: active || external-inside ? Theme.selection : hit.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    accessible-role: button; accessible-label: node.name; accessible-action-default => { root.select(); }
    forward-focus: nav-focus;
    if active: Rectangle { x: root.group ? 12px : 0px; y: root.group ? parent.height - 3px : 10px; width: root.group ? parent.width - 24px : 3px; height: root.group ? 3px : 18px; border-radius: 2px; background: Palette.accent-background; }
    DropArea {
        can-drop(event) => { root.insert-after = root.group ? event.position.x > self.width / 2 : event.position.y > self.height / 2; return root.can-drop(event.data) ? DragAction.move : DragAction.none; }
        dropped(event) => { return root.drop-data(event.data,root.insert-after) ? DragAction.move : DragAction.none; }
        Timer { running: parent.has-drag; interval: 350ms; triggered => { root.select(); } }
        if self.has-drag: Rectangle { x: root.group && root.insert-after ? parent.width - 2px : 0px; y: !root.group && root.insert-after ? parent.height - 2px : 0px; width: root.group ? 2px : parent.width; height: root.group ? parent.height : 2px; background: Palette.accent-background; }
        DragArea { enabled: root.node.id > 0; allow-move: true; data: root.drag-data();
            Rectangle {

                nav-label := Text { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; text: root.node.name; color: root.active ? Palette.accent-background : Palette.foreground; horizontal-alignment: root.group ? center : left; vertical-alignment: center; wrap: root.group ? no-wrap : word-wrap; }
                nav-focus := FocusScope { key-pressed(event) => { if event.text == Key.Return { root.select(); return accept; } if event.text == Key.F2 && root.node.id > 0 { root.action(2, 0); return accept; } return reject; } }
                hit := TouchArea { clicked => { nav-focus.focus(); root.select(); } pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.up { root.open-menu(); } } }
                Timer { running: root.hover-switch && hit.has-hover && !root.active; interval: root.hover-delay * 1ms; triggered => { root.select(); } }
            }
        }
    }

}

/// Expandable group / category tree shared by the batch organizer and the project editor, so the
/// two cannot drift apart in indentation, focus ring or keyboard behaviour.
component NavTree inherits Rectangle {
    in property <[DestinationNode]> nodes;
    in property <int> selected;
    in property <int> cursor;
    callback pick(int);
    callback key(int);
    public function focus-tree() { tree-focus.focus(); }
    tree-focus := FocusScope {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.DownArrow { root.key(1); return accept; }
            if event.text == Key.UpArrow { root.key(-1); return accept; }
            if event.text == Key.RightArrow { root.key(2); return accept; }
            if event.text == Key.LeftArrow { root.key(-2); return accept; }
            if event.text == Key.Return || event.text == " " { root.key(0); return accept; }
            return reject;
        }
        ScrollView {
            content-width: self.visible-width;
            content-y: -max(0px, min(root.cursor * 36px - self.visible-height + 36px, max(0px, self.content-height - self.visible-height)));
            VerticalLayout { spacing: 0px;
                for node[index] in root.nodes: Rectangle {
                    height: 36px; border-radius: Theme.radius-md;
                    background: root.selected == node.id ? Theme.selection : row-hit.has-hover ? Theme.hover : transparent;
                    animate background { duration: 100ms; easing: ease-out; }
                    border-width: root.cursor == index && tree-focus.has-focus ? 1px : 0px; border-color: Theme.stroke;
                    accessible-role: button; accessible-label: node.name; accessible-action-default => { root.pick(node.id); }
                    Image { x: node.parent == 0 ? 4px : 24px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: node.parent == 0 ? (node.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg")) : @image-url("icons/folder.svg"); colorize: Palette.foreground; }
                    Text { x: node.parent == 0 ? 26px : 46px; width: parent.width - self.x - 6px; height: parent.height; text: node.name; vertical-alignment: center; overflow: elide; color: Palette.foreground; }
                    row-hit := TouchArea { clicked => { tree-focus.focus(); root.pick(node.id); } }
                    Tooltip { HintSurface { title: node.name; } }
                }
            }
        }
    }
}

export component MainWindow inherits AppWindow {
    in-out property <bool> window-active <=> root.frame-active;
    in property <int> dock-edge: -1;
    in property <length> dock-overhang: 0px;
    in property <float> edge-progress: 0.0;
    in property <length> edge-strip-size: 1px;
    inset-left: root.dock-edge == 0 ? root.dock-overhang : 0px;
    inset-right: root.dock-edge == 1 ? root.dock-overhang : 0px;
    inset-top: root.dock-edge == 2 ? root.dock-overhang : 0px;
    title: "Raptim";
    preferred-width: 440px; preferred-height: 640px;
    min-width: 400px + root.inset-left + root.inset-right; min-height: 450px + root.inset-top;
    in property <[NavItem]> groups;
    in property <[NavItem]> destinations;
    in property <[NavItem]> categories;
    in property <bool> double-click;
    in property <bool> type-to-search;
    in property <int> icon-size: 1;
    in property <bool> list-view;
    callback view-change(int);
    in property <bool> hover-switch;
    in property <int> hover-delay: 350;
    in-out property <bool> keyboard-focus;
    out property <int> grid-columns: content.columns;
    callback pin-changed;
    callback drag-start;
    callback change-icon(int);
    callback convert-path(int, bool);
    in property <[Item]> items;
    in-out property <length> grid-scroll <=> content.content-y;
    in-out property <int> search-scope;
    callback search-scope-changed;
    in-out property <bool> batch-mode;
    in property <int> batch-count;
    in-out property <bool> batch-confirm;
    in-out property <int> batch-destination;
    in property <bool> batch-all-selected;
    in-out property <bool> batch-target-open;
    in property <int> batch-action;
    in property <[DestinationNode]> batch-nodes;
    in property <string> batch-target-name;
    in-out property <string> batch-error;
    in property <int> batch-tree-index;
    callback batch-target(int);
    callback batch-node(int);
    callback batch-tree-key(int);
    public function focus-batch-tree() { batch-tree.focus-tree(); }
    callback batch-start(int);
    callback batch-all;
    callback batch-cancel;
    callback batch-execute(int, int);
    callback viewport-changed;
    callback interaction-changed;
    changed interacting => { root.interaction-changed(); }
    changed search-open => { root.interaction-changed(); }
    out property <int> grid-first: max(0, floor(-content.content-y / content.row-height) - 1) * content.columns;
    out property <int> grid-visible-count: (ceil(content.visible-height / content.row-height) + 3) * content.columns;
    out property <int> search-first: max(0, floor(-search-results.content-y / 64px) - 1);
    out property <int> search-visible-count: ceil(search-results.visible-height / 64px) + 3;
    changed grid-first => { root.viewport-changed(); }
    changed grid-visible-count => { root.viewport-changed(); }
    changed search-first => { root.viewport-changed(); }

    in property <int> group-id;
    in property <int> category-id;
    in-out property <int> selected-id;
    in-out property <string> query;
    in-out property <string> status;
    in-out property <bool> confirm-delete;
    in-out property <bool> pinned;
    in-out property <bool> drop-hover;
    in-out property <length> external-x: -1px;
    in-out property <length> external-y: -1px;
    in-out property <int> external-category;

    in property <bool> busy;
    out property <bool> search-focused: search-input.has-focus;
    callback search(string);
    callback choose-group(int);
    callback choose-category(int);
    callback launch(int);
    callback edit(int);
    callback native-menu(int, int);
    callback copy-to(int, int);
    callback add;
    callback add-files;
    callback move(int, int);
    callback move-to(int, int);
    callback remove(int);
    callback manage-group(int);
    callback collection-action(int, int, int);
    callback item-action(int, int);
    callback global-action(int);
    callback scope-toggle(int, bool);
    callback scope-all(bool);
    callback apply-conversion;
    callback begin-conversion(bool);
    callback commit-name;
    callback cancel-name;
    callback finish-delete(int);
    pure callback nav-drag(int) -> data-transfer;
    callback nav-can-drop(data-transfer, int) -> bool;
    callback nav-drop(data-transfer, int, bool) -> bool;
    in property <[Item]> results;
    in property <[ScopeNode]> scopes;
    in property <bool> scope-selected;
    in property <[NavItem]> delete-destinations;
    in property <[string]> delete-names;
    in-out property <int> delete-target;
    in-out property <bool> collection-delete;
    in-out property <bool> conversion-open;
    in-out property <bool> conversion-relative;
    in property <string> conversion-summary;
    in property <string> conversion-details;
    in-out property <bool> search-open;
    in-out property <int> saved-selection;
    in-out property <int> inline-kind;
    in-out property <int> inline-id;
    in-out property <string> inline-text;
    in-out property <string> inline-error;
    in-out property <string> inline-context;
    in-out property <string> delete-name;
    in-out property <bool> delete-has-content;
    in-out property <bool> delete-is-group;
    in-out property <bool> delete-discard;
    in-out property <bool> more-open;
    in-out property <bool> relocate-open;
    in-out property <bool> discover-open;
    in property <bool> discover-loading;
    in-out property <string> discover-filter;
    in property <[DiscoverOption]> discover-items;
    in property <int> discover-selected-count;
    in property <string> discover-target-name;
    callback discover-apps;
    callback discover-refilter;
    callback discover-toggle(int);
    callback discover-all(bool);
    callback discover-import;
    in-out property <bool> broken-open;
    in property <bool> broken-loading;
    in property <[BrokenOption]> broken-items;
    callback broken-check;
    callback broken-relocate(int);
    callback broken-edit(int);
    callback broken-remove(int);
    /// Set from the winit event filter, which runs before Slint sees the key. The guard below is
    /// the layer an offscreen test can prove; the filter is the layer that fixes real delivery.
    in property <bool> composing;
    in property <string> relocate-name;
    in property <string> relocate-target;
    in property <string> relocate-message;
    public function show-more() { root.native-menu(0,0); }

    out property <bool> interacting: root.batch-mode || root.more-open || root.search-open || root.conversion-open || root.collection-delete || root.confirm-delete || root.relocate-open || root.discover-open || root.broken-open;
    public function dismiss-search() { root.search-open = false; root.query = ""; root.search(""); root.restore-grid-focus(); }
    public function reveal-result(index: int) {
        if index * 64px < -search-results.content-y { search-results.content-y = -index * 64px; }
        else if (index + 1) * 64px > -search-results.content-y + search-results.height { search-results.content-y = search-results.height - (index+1)*64px; }
    }
    public function reveal-grid-row(row: int) {
        if row * content.row-height < -content.content-y { content.content-y = -row * content.row-height; }
        else if (row + 1) * content.row-height > -content.content-y + content.visible-height {
            content.content-y = min(0px, content.visible-height - (row + 1) * content.row-height);
        }
    }
    public function restore-grid-focus() { root.selected-id = root.saved-selection; grid-focus.focus(); }
    public function focus-browser() { if root.search-open { search-input.focus(); } else { grid-focus.focus(); } }
    public function focus-discover-filter() { discover-filter-input.focus(); discover-filter-input.select-all(); }
    public function start-type-search(ch: string) {
        if !root.search-open { root.saved-selection = root.selected-id; }
        root.search-open = true;
        root.query = ch;
        search-input.focus();
        // Move caret after the seeded character so subsequent keystrokes append instead of prepending.
        search-input.set-selection-offsets(2147483647, 2147483647);
        root.search(ch);
    }
    callback settings;
    callback quit;
    callback request-hide;
    callback escape;
    callback flush-events;
    callback relocate;
    pure callback make-drag(int) -> data-transfer;
    callback can-drop(data-transfer) -> bool;
    callback drop-before(data-transfer, int, bool) -> bool;
    public function focus-search() { if !root.search-open { root.saved-selection = root.selected-id; } root.search-open = true; search-input.focus(); search-input.select-all(); }
    public function clear-search() { root.query = ""; root.search(""); search-input.focus(); }
    public function submit-search() { if root.results.length > 0 { root.launch(root.selected-id != 0 ? root.selected-id : root.results[0].id); } }
    public function close-popups() { root.more-open = false; grid-focus.focus(); }
    public function focus-inline-name() { inline-name.focus(); inline-name.select-all(); }
    grid-focus := FocusScope { key-pressed(event) => {
        if root.batch-target-open || root.batch-confirm { return reject; }
        if root.batch-mode && !root.search-focused && !root.batch-target-open && !root.batch-confirm && event.modifiers.control && event.text.to-lowercase() == "a" { if !root.batch-all-selected { root.batch-all(); } return accept; }
        if !root.batch-mode && root.selected-id != 0 && event.text == Key.F2 { root.edit(root.selected-id); return accept; }
        if root.selected-id != 0 && event.text == Key.Return { root.launch(root.selected-id); return accept; }
        return reject;
    } }
    VerticalLayout {
        padding: 1px; spacing: 0px;
        Rectangle { height: 44px;
            TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag-start(); } } }
            HorizontalLayout { padding-left: 10px; padding-right: 6px; padding-top: 6px; padding-bottom: 6px; spacing: 2px;
            if !root.search-open: IconButton { icon: @image-url("icons/search.svg"); label: I18n.en ? "Search · Ctrl+F" : "搜索 · Ctrl+F"; clicked => { root.focus-search(); } }
            Rectangle { visible: root.search-open; horizontal-stretch: 1; min-width: root.search-open ? 230px : 0px;
                HorizontalLayout { spacing: 4px;
                    SettingsSelect { width: 108px; horizontal-stretch: 0; model: I18n.en ? ["All", "Group", "Category"] : ["全部", "当前分组", "当前分类"]; current-index <=> root.search-scope; accessible-name: I18n.en ? "Search scope" : "搜索范围"; selected(_) => { root.search-scope-changed(); } }
                    search-input := LineEdit { min-width: 72px; text <=> root.query; placeholder-text: I18n.en ? "Search items" : "搜索项目"; accessible-label: I18n.en ? "Search saved items" : "搜索已收录项目"; edited(value) => { root.search(value); } accepted => { if !root.composing { root.submit-search(); } } }
                    IconButton { icon: @image-url("icons/close.svg"); label: root.query == "" ? (I18n.en ? "Close search" : "关闭搜索") : (I18n.en ? "Clear search" : "清空搜索"); clicked => { if root.query == "" { root.dismiss-search(); } else { root.clear-search(); } } }
                }
            }
            if !root.search-open: Rectangle { horizontal-stretch: 1; }
            if !root.search-open: Rectangle { width: 32px;
            IconButton { icon: @image-url("icons/add.svg"); label: I18n.en ? "Add item" : "添加项目"; clicked => { root.add(); } }
            }
            if !root.search-open: Rectangle { width: 32px;
            IconButton { icon: @image-url("icons/pin.svg"); label: root.pinned ? (I18n.en ? "Unpin" : "取消固定") : (I18n.en ? "Pin" : "临时固定"); checked: root.pinned; clicked => { root.pinned = !root.pinned; root.pin-changed(); } }
            }
            IconButton { icon: @image-url("icons/more.svg"); label: I18n.en ? "More" : "更多"; checked: root.more-open; clicked => { root.show-more(); } }
            IconButton { icon: @image-url("icons/close.svg"); label: I18n.en ? "Close" : "关闭"; danger: true; clicked => { root.request-hide(); } }
            }
        }
        // Groups share the title surface; categories occupy the vertical rail.
        Rectangle { height: 46px; background: Theme.canvas;
            HorizontalLayout { padding-left: 10px; padding-right: 8px; padding-bottom: 6px; spacing: 4px;
                group-tabs := ScrollView {
                    content-width: max(self.visible-width, group-row.preferred-width);
                    content-height: 36px;
                    group-row := HorizontalLayout { spacing: 4px; alignment: start;
                    for group[index] in root.groups: NavNode {
                        horizontal-stretch: 0; height: 36px;
                        node: group; group: true; groups: root.groups; active: root.group-id == group.id;
                        changed active => { if self.active { group-tabs.content-x = min(0px, max(group-tabs.visible-width - group-tabs.content-width, -self.x)); } }
                        hover-switch: root.hover-switch && !root.interacting; hover-delay: root.hover-delay;
                        select => { root.choose-group(group.id); }
                        action(kind,target) => { root.collection-action(group.id,kind,target); }
                        drag-data => { return root.nav-drag(group.id); }
                        can-drop(data) => { return root.nav-can-drop(data,group.id); }
                        drop-data(data,after) => { return root.nav-drop(data,group.id,after); }
                        open-menu => { root.native-menu(2,group.id); }
                    }
                    }
                }
                IconButton { icon: @image-url("icons/add.svg"); label: I18n.en ? "New group" : "新建分组"; clicked => { root.collection-action(0,0,0); } }
            }
        }
        Rectangle { height: 1px; background: Theme.stroke; }
        HorizontalLayout { spacing: 0px;
            Rectangle { width: 92px; background: Theme.navigation;
                VerticalLayout { padding: 6px; spacing: 4px;
                    category-scroll := ScrollView { content-width: self.visible-width;
                        // Flickable does not compute content-height for `for` loops, so bind it
                        // explicitly: this is the scroll range of the rail.
                        content-height: category-list.preferred-height;
                        category-list := VerticalLayout { spacing: 4px; alignment: start;
                            for category in root.categories: NavNode {
                                external-x: root.external-x; external-y: root.external-y; external-drag: root.drop-hover && root.external-y >= category-scroll.absolute-position.y && root.external-y < category-scroll.absolute-position.y + category-scroll.height;
                                external-hit(id) => { if id > 0 { root.external-category = id; } else if root.external-category == -id { root.external-category = 0; } }
                                node: category; groups: root.groups; active: root.category-id == category.id;
                                hover-switch: root.hover-switch && !root.interacting; hover-delay: root.hover-delay;
                                select => { root.choose-category(category.id); }
                                action(kind,target) => { root.collection-action(category.id,kind,target); }
                                drag-data => { return root.nav-drag(category.id); }
                                can-drop(data) => { return root.nav-can-drop(data,category.id); }
                                drop-data(data,after) => { return root.nav-drop(data,category.id,after); }
                                open-menu => { root.native-menu(3,category.id); }
                            }
                        }
                    }
                    IconButton { icon: @image-url("icons/add.svg"); label: I18n.en ? "New category" : "新建子分类"; clicked => { root.collection-action(0,1,0); } }
                }
            }
            Rectangle { width: 1px; horizontal-stretch: 0; background: Theme.subtle-stroke; }
            Rectangle { background: Theme.surface;
                VerticalLayout { padding: 12px; spacing: 8px;
                    Rectangle {
                        TouchArea { pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.up { root.native-menu(4,root.category-id); } } }
                        content := ListView {
                            content-width: self.visible-width;
                            property <int> columns: root.list-view ? 1 : max(2, min(root.icon-size == 0 ? 5 : root.icon-size == 2 ? 3 : 4, floor(self.visible-width / (root.icon-size == 0 ? 58px : root.icon-size == 2 ? 92px : 72px))));
                            property <length> col-gap: root.list-view ? 0px : 6px;
                            property <length> cell-width: max(0px, (self.visible-width - self.col-gap * (self.columns - 1)) / self.columns);
                            property <length> row-height: root.list-view ? 64px : root.icon-size == 0 ? 88px : root.icon-size == 2 ? 118px : 104px;
                            for row in ceil(root.items.length / content.columns) + (root.batch-mode && root.items.length > 0 ? 1 : 0): Rectangle {
                            height: content.row-height;
                            for col in content.columns: Tile {
                                property <int> item-index: row * content.columns + col;
                                property <Item> entry: root.items[self.item-index];
                                visible: self.item-index < root.items.length;
                                item: self.entry; batch-mode: root.batch-mode; list-mode: root.list-view; icon-size: root.icon-size == 0 ? 28px : root.icon-size == 2 ? 48px : 36px; double-click: root.double-click; destinations: root.destinations;
                                selected: root.selected-id == self.entry.id; keyboard-focused: root.keyboard-focus; sortable: !root.busy && !root.batch-mode && root.inline-kind == 0;
                                x: col * (content.cell-width + content.col-gap);
                                y: 0px;
                                width: content.cell-width; height: content.row-height - 6px;
                                launch => { if !root.busy { root.launch(self.entry.id); } }
                                select => { root.keyboard-focus = false; root.selected-id = self.entry.id; }
                                edit => { root.edit(self.entry.id); } open-menu => { root.native-menu(1,self.entry.id); }
                                action(kind) => { root.item-action(self.entry.id,kind); }
                                change-icon => { root.change-icon(self.entry.id); } convert-path(relative) => { root.convert-path(self.entry.id,relative); }
                                remove => { root.selected-id = self.entry.id; root.delete-name = self.entry.name; root.inline-error = ""; root.confirm-delete = true; }
                                move(direction) => { root.move(self.entry.id,direction); } move-to(destination) => { root.move-to(self.entry.id,destination); }
                                make-drag => { return root.make-drag(self.entry.id); }
                                can-drop(data) => { return root.can-drop(data); } drop-before(data,after) => { return root.drop-before(data,self.entry.id,after); }
                            }
                            }
                        }
                            if root.items.length == 0: VerticalLayout { width: parent.width; height: 220px; alignment: center; spacing: 12px;
                                Text { text: I18n.en ? "No items yet" : "还没有项目"; color: Palette.alternate-foreground; horizontal-alignment: center; }
                                Text { text: I18n.en ? "You can also drop files, shortcuts, or URLs here" : "也可以直接拖入文件、快捷方式或网址"; color: Palette.alternate-foreground; font-size: 12px; horizontal-alignment: center; }
                                HorizontalLayout { alignment: center; spacing: 8px;
                                    Button { text: I18n.en ? "Add item" : "添加项目"; clicked => { root.add(); } }
                                    Button { text: I18n.en ? "Scan & import" : "扫描导入"; clicked => { root.discover-apps(); } }
                                }
                            }
                    }
                }
            }
        }
    }
    // `visible:` rather than `if`, so `focus-inline-name` can reach the LineEdit id: an element
    // inside a conditional block is scoped to that block.
    Rectangle {
        visible: root.inline-kind != 0 || self.opacity > 0.01;
        opacity: root.inline-kind != 0 ? 1 : 0;
        animate opacity { duration: 150ms; easing: ease-out; }
        background: Theme.scrim;
        TouchArea { enabled: root.inline-kind != 0; }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (root.inline-kind != 0 ? 0px : 8px);
            animate y { duration: 150ms; easing: ease-out; }
            width: 360px; height: 214px;
            background: Theme.elevated; border-width: 1px; border-color: Theme.stroke; border-radius: Theme.radius-lg;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            VerticalLayout { padding: 20px; spacing: 12px;
                Text { text: root.inline-kind == 3 ? (I18n.en ? "New group" : "新建分组") : root.inline-kind == 4 ? (I18n.en ? "New category" : "新建子分类") : (I18n.en ? "Rename" : "修改名称"); font-weight: 600; color: Palette.foreground; }
                Text { text: I18n.en ? "Name" : "名称"; color: Palette.alternate-foreground; }
                inline-name := LineEdit { text <=> root.inline-text; accessible-label: I18n.en ? "Name" : "名称";
                    accepted => { if !root.composing { root.commit-name(); } } }
                if root.inline-error != "": Text { text: root.inline-error; color: Theme.danger; wrap: word-wrap; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: I18n.en ? "Cancel" : "取消"; clicked => { root.cancel-name(); } }
                    Button { text: I18n.en ? "OK" : "确定"; primary: true; enabled: root.inline-text != ""; clicked => { root.commit-name(); } }
                }
            }
        }
    }
    if root.drop-hover: Rectangle { background: #0078d422; border-width: 2px; border-color: Palette.accent-background; border-radius: Theme.radius-lg; }
    Rectangle {
        visible: root.search-open || self.opacity > 0.01;
        opacity: root.search-open ? 1 : 0;
        animate opacity { duration: 150ms; easing: ease-out; }
        y: 44px; height: parent.height - 44px; background: Theme.scrim;
        TouchArea { enabled: root.search-open; clicked => { root.dismiss-search(); } }
        Rectangle {
            x: 12px;
            y: root.search-open ? 8px : 0px;
            animate y { duration: 150ms; easing: ease-out; }
            width: parent.width - 24px;
            height: parent.height - 20px;
            background: Theme.elevated; border-width: 1px; border-color: Theme.stroke; border-radius: Theme.radius-lg;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            TouchArea { enabled: root.search-open; }
            VerticalLayout { padding: 12px; spacing: 10px;
                if root.results.length == 0: Text { text: root.query == "" ? (I18n.en ? "Search all saved items" : "搜索全部已收录项目") : (I18n.en ? "No matching items" : "没有匹配项目"); color: Palette.alternate-foreground; horizontal-alignment: center; }
                search-results := ListView {
                        for item in root.results: Tile { height: 64px; item: item; list-mode: true; search-result: true; batch-mode: root.batch-mode; destinations: root.destinations; double-click: root.double-click;
                            selected: root.selected-id == item.id;
                                launch => { if !root.busy { root.launch(item.id); } }
                                select => { root.selected-id = item.id; }
                                edit => { root.edit(item.id); } open-menu => { root.native-menu(1,item.id); }
                                action(kind) => { root.item-action(item.id,kind); }
                                change-icon => { root.change-icon(item.id); } convert-path(relative) => { root.convert-path(item.id,relative); }
                                remove => { root.selected-id = item.id; root.delete-name = item.name; root.inline-error = ""; root.confirm-delete = true; }
                                move(direction) => { root.move(item.id,direction); } move-to(destination) => { root.move-to(item.id,destination); }
                        }
                }

            }
        }
    }
    Rectangle {
        visible: root.batch-mode || self.opacity > 0.01;
        x: 16px; width: parent.width - 32px; height: 48px;
        y: root.batch-mode ? parent.height - 62px : parent.height - 46px;
        opacity: root.batch-mode ? 1 : 0;
        animate y, opacity { duration: 180ms; easing: ease-out; }
        ElevationShadow { width: parent.width; height: parent.height; }
        Rectangle {
            width: parent.width; height: parent.height;
            background: Theme.elevated; border-radius: Theme.radius-lg; border-width: 1px; border-color: Theme.elevated-stroke;
            TouchArea { enabled: root.batch-mode; }
            HorizontalLayout { padding-left: 10px; padding-right: 6px; spacing: 4px;
                Rectangle {
                    y: 11px; height: 26px; border-radius: Theme.radius-md; horizontal-stretch: 0;
                    background: root.batch-count > 0 ? Palette.accent-background : Theme.hover;
                    animate background { duration: 120ms; easing: ease-out; }
                    HorizontalLayout { padding-left: 10px; padding-right: 10px;
                        Text {
                            text: I18n.en ? root.batch-count + " selected" : "已选 " + root.batch-count;
                            font-size: 12px; font-weight: 600;
                            color: root.batch-count > 0 ? Palette.accent-foreground : Palette.foreground;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { width: 2px; horizontal-stretch: 0; }
                BatchActionButton { y: 9px; text: root.batch-all-selected ? (I18n.en ? "Clear" : "全不选") : (I18n.en ? "All" : "全选"); tooltip: "Ctrl+A"; enabled: root.batch-mode; clicked => { root.batch-all(); } }
                Rectangle { horizontal-stretch: 1; }
                BatchActionButton { y: 9px; text: I18n.en ? "Move" : "移动"; enabled: root.batch-mode && root.batch-count > 0; clicked => { root.batch-target(0); } }
                BatchActionButton { y: 9px; text: I18n.en ? "Copy" : "复制"; enabled: root.batch-mode && root.batch-count > 0; clicked => { root.batch-target(1); } }
                BatchActionButton { y: 9px; danger: true; text: I18n.en ? "Delete" : "删除"; enabled: root.batch-mode && root.batch-count > 0; clicked => { root.batch-error = ""; root.batch-confirm = true; } }
                Rectangle { width: 1px; height: 18px; y: 15px; background: Theme.stroke; }
                IconButton { y: 8px; icon: @image-url("icons/close.svg"); label: I18n.en ? "Done · Esc" : "完成 · Esc"; enabled: root.batch-mode; clicked => { root.batch-cancel(); } }
            }
        }
    }
    ToastBar {
        x: 16px; width: parent.width - 32px;
        container-height: parent.height;
        bottom-offset: root.batch-mode ? 72px : 14px;
        text: root.status;
        dismiss => { root.status = ""; }
    }
    Rectangle {
        visible: root.batch-target-open || self.opacity > 0.01;
        opacity: root.batch-target-open ? 1 : 0;
        animate opacity { duration: 150ms; easing: ease-out; }
        background: Theme.scrim;
        TouchArea { enabled: root.batch-target-open; }
        Rectangle {
            x: 16px; y: root.batch-target-open ? 52px : 60px; width: parent.width - 32px; height: parent.height - 76px;
            animate y { duration: 150ms; easing: ease-out; }
            background: Theme.elevated; border-width: 1px; border-color: Theme.stroke; border-radius: Theme.radius-lg;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            VerticalLayout { padding: 14px; spacing: 10px;
                Text { text: root.batch-action == 0 ? (I18n.en ? "Move to" : "移动到") : (I18n.en ? "Copy to" : "复制到"); font-size: 16px; font-weight: 600; color: Palette.foreground; }
                batch-tree := NavTree {
                    nodes: root.batch-nodes; selected: root.batch-destination; cursor: root.batch-tree-index;
                    pick(id) => { root.batch-node(id); }
                    key(delta) => { root.batch-tree-key(delta); }
                }
                Text { text: root.batch-target-name; color: Palette.foreground; wrap: word-wrap; }
                if root.batch-error != "": Text { text: root.batch-error; color: Theme.danger; wrap: word-wrap; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: I18n.en ? "Cancel" : "取消"; clicked => { root.batch-target-open = false; root.focus-browser(); } }
                    Button { text: root.batch-action == 0 ? (I18n.en ? "Move" : "移动") : (I18n.en ? "Copy" : "复制"); primary: true; enabled: root.batch-destination != 0; clicked => { root.batch-execute(root.batch-action,root.batch-destination); } }
                }
            }
        }
    }
    if root.batch-confirm: Rectangle { background: Theme.scrim; TouchArea { }
        Rectangle { x: 20px; y: (parent.height - self.height) / 2; width: parent.width - 40px; height: self.preferred-height; background: Theme.elevated; border-width: 1px; border-color: Theme.stroke; border-radius: Theme.radius-lg; drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            VerticalLayout { padding: 16px; spacing: 12px;
                Text { text: I18n.en ? "Delete " + root.batch-count + (root.batch-count == 1 ? " selected item?" : " selected items?") : "删除选中的 " + root.batch-count + " 个项目？"; color: Palette.foreground; font-weight: 600; }
                Text { text: I18n.en ? "Only launcher entries are removed; original files remain." : "只删除启动器记录，原文件保留。"; color: Palette.alternate-foreground; wrap: word-wrap; }
                if root.batch-error != "": Text { text: root.batch-error; color: Theme.danger; wrap: word-wrap; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: I18n.en ? "Cancel" : "取消"; clicked => { root.batch-confirm = false; root.focus-browser(); } }
                    Button { text: I18n.en ? "Delete" : "删除"; primary: true; clicked => { root.batch-execute(2,0); } }
                }
            }
        }
    }
    if root.relocate-open: Rectangle { background: Theme.scrim; TouchArea { }
        Rectangle { x: 20px; y: (parent.height - self.height) / 2; width: parent.width - 40px; height: self.preferred-height; background: Theme.elevated; border-radius: Theme.radius-lg; border-width: 1px; border-color: Theme.stroke; drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            VerticalLayout { padding: 16px; spacing: 12px;
                Text { text: I18n.en ? "Relocate \"" + root.relocate-name + "\"" : "重新定位「" + root.relocate-name + "」"; color: Palette.foreground; wrap: word-wrap; }
                Text { text: root.relocate-target; color: Palette.alternate-foreground; wrap: word-wrap; font-size: 12px; }
                Text { text: root.relocate-message; color: Palette.alternate-foreground; wrap: word-wrap; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: I18n.en ? "Cancel" : "取消"; clicked => { root.relocate-open = false; root.focus-browser(); } }
                    Button { text: I18n.en ? "Choose new target" : "选择新目标"; clicked => { root.relocate(); } }
                }
            }
        }
    }
    if root.conversion-open: Rectangle { background: Theme.scrim; TouchArea { }
        Rectangle { x: 12px; y: 52px; width: parent.width - 24px; height: parent.height - 72px; background: Theme.elevated; border-radius: Theme.radius-lg; border-width: 1px; border-color: Theme.stroke; drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            VerticalLayout { padding: 16px; spacing: 12px;
                Text { text: root.conversion-relative ? (I18n.en ? "Convert to relative paths" : "转换为相对路径") : (I18n.en ? "Convert to absolute paths" : "转换为绝对路径"); font-size: 18px; font-weight: 600; color: Palette.foreground; }
                HorizontalLayout { alignment: start; spacing: 8px; Button { text: I18n.en ? "Select all" : "全选"; clicked => { root.scope-all(true); } } Button { text: I18n.en ? "Clear" : "清空"; clicked => { root.scope-all(false); } } }
                ScrollView { content-width: self.visible-width;
                    VerticalLayout { spacing: 4px; alignment: start;
                        for node in root.scopes: HorizontalLayout { height: 32px; padding-left: node.depth * 20px;
                            Rectangle { horizontal-stretch: 1; height: 32px;
                                accessible-role: checkbox; accessible-label: node.label; accessible-checked: node.state == 2;
                                accessible-action-default => { root.scope-toggle(node.id,node.state != 2); }
                                Rectangle { x:0px; y:7px; width:18px; height:18px; border-radius:Theme.radius-sm; border-width:1px; border-color: node.state == 0 ? Theme.stroke : Palette.accent-background; background: node.state == 0 ? Theme.surface : Palette.accent-background;
                                    animate background, border-color { duration: 120ms; easing: ease-out; }
                                    if node.state == 1: Rectangle { x: 5px; y: 8px; width: 8px; height: 2px; border-radius: 1px; background: Palette.accent-foreground; }
                                    if node.state == 2: Image { x: 3px; y: 3px; width: 12px; height: 12px; source: @image-url("icons/check.svg"); colorize: Palette.accent-foreground; accessible-role: none; }
                                }
                                Text { x:28px; width:parent.width - 28px; text:node.label; color:Palette.foreground; vertical-alignment:center; overflow:elide; }
                                FocusScope { key-pressed(event) => { if event.text == " " { root.scope-toggle(node.id,node.state != 2); return accept; } return reject; } }
                                TouchArea { clicked => { root.scope-toggle(node.id,node.state != 2); } }
                            }
                        }
                    }
                }
                Text { text: root.conversion-summary; wrap: word-wrap; color: Palette.foreground; }
                if root.conversion-details != "": ScrollView { height: 70px; content-width: self.visible-width; Text { text: root.conversion-details; wrap: word-wrap; color: Palette.alternate-foreground; font-size: 12px; } }
                HorizontalLayout { alignment: end; Button { text: I18n.en ? "Close" : "关闭"; clicked => { root.conversion-open = false; } } Button { text: I18n.en ? "Convert" : "转换"; primary: true; enabled: root.scope-selected && !root.busy; clicked => { root.apply-conversion(); } } }
            }
        }
    }
    if root.collection-delete || root.confirm-delete: Rectangle { background: Theme.scrim; TouchArea { }
        Rectangle { width: parent.width - 32px; height: delete-form.preferred-height; x: 16px; y: (parent.height - self.height) / 2; border-radius: Theme.radius-lg; border-width: 1px; border-color: Theme.stroke; background: Theme.elevated; drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if event.text == Key.Escape { root.confirm-delete = false; root.collection-delete = false; return accept; }
                    if event.text == Key.Return {
                        if root.collection-delete { root.finish-delete(root.delete-target); }
                        else { root.remove(root.selected-id); root.confirm-delete = false; }
                        return accept;
                    }
                    return reject;
                }
            }
            delete-form := VerticalLayout { padding: 20px; spacing: 14px;
                Text { text: root.collection-delete ? (root.delete-is-group ? (I18n.en ? "Delete group?" : "删除分组？") : (I18n.en ? "Delete category?" : "删除分类？")) : (I18n.en ? "Delete item?" : "删除项目？"); font-size: 18px; font-weight: 600; color: Palette.foreground; }
                Text { text: root.delete-name; color: Palette.foreground; overflow: elide; font-weight: 600; }
                Text { text: root.collection-delete ? (root.delete-has-content ? (root.delete-discard ? (I18n.en ? "Items and subcategories will be removed from Raptim. Original files will not be deleted." : "项目和子分类将一并从 Raptim 移除，原文件不会被删除。") : (I18n.en ? "Move contents to the destination below, then delete." : "将内容迁移到下列位置，然后删除。")) : (I18n.en ? "This container is empty and can be deleted directly." : "此位置没有内容，可以直接删除。")) : (I18n.en ? "Only removed from Raptim; original files will not be deleted." : "仅从 Raptim 移除，原文件不会被删除。"); wrap: word-wrap; color: Palette.alternate-foreground; }
                if root.collection-delete && root.delete-has-content && !root.delete-discard: SettingsSelect { model: root.delete-names; current-index <=> root.delete-target; accessible-name: I18n.en ? "Move contents to" : "内容迁移到"; }
                if root.collection-delete && root.delete-has-content: CheckBox { text: I18n.en ? "Delete items and subcategories without moving" : "不迁移，直接删除其中的项目和子分类"; checked <=> root.delete-discard; }
                if root.inline-error != "": Text { text: root.inline-error; wrap: word-wrap; color: Theme.danger; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: I18n.en ? "Cancel" : "取消"; clicked => { root.confirm-delete = false; root.collection-delete = false; } }
                    Button { text: root.collection-delete && root.delete-has-content && !root.delete-discard ? (I18n.en ? "Move & delete" : "迁移并删除") : (I18n.en ? "Delete" : "删除"); primary: true; clicked => { if root.collection-delete { root.finish-delete(root.delete-target); } else { root.remove(root.selected-id); root.confirm-delete = false; } } }
                }
            }
        }
    }
    // `visible:` rather than `if`, so `focus-discover-filter` can reach `discover-filter-input`.
    Rectangle {
        visible: root.discover-open || self.opacity > 0.01;
        opacity: root.discover-open ? 1 : 0;
        animate opacity { duration: 150ms; easing: ease-out; }
        background: Theme.scrim;
        TouchArea { enabled: root.discover-open; }
        Rectangle {
            x: 16px; y: root.discover-open ? 48px : 56px; width: parent.width - 32px; height: parent.height - 68px;
            animate y { duration: 150ms; easing: ease-out; }
            background: Theme.elevated; border-width: 1px; border-color: Theme.stroke; border-radius: Theme.radius-lg;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            VerticalLayout { padding: 14px; spacing: 10px;
                Text { text: I18n.en ? "Scan & import installed apps" : "扫描导入已安装软件"; font-size: 16px; font-weight: 600; color: Palette.foreground; }
                Text { text: (I18n.en ? "Destination: " : "导入目标：") + root.discover-target-name; color: Palette.alternate-foreground; font-size: 12px; overflow: elide; }
                discover-filter-input := LineEdit { text <=> root.discover-filter; placeholder-text: I18n.en ? "Filter by name or path" : "按名称或路径筛选"; accessible-label: I18n.en ? "Filter apps" : "筛选软件"; changed text => { root.discover-refilter(); } }
                HorizontalLayout { spacing: 8px; alignment: start;
                    Button { text: I18n.en ? "Select all" : "全选"; enabled: !root.discover-loading && root.discover-items.length > 0; clicked => { root.discover-all(true); } }
                    Button { text: I18n.en ? "Select none" : "全不选"; enabled: !root.discover-loading && root.discover-items.length > 0; clicked => { root.discover-all(false); } }
                    Text { text: root.discover-loading ? (I18n.en ? "Scanning Start Menu and installed apps…" : "正在扫描开始菜单与应用列表…") : (I18n.en ? "Selected " : "已选 ") + root.discover-selected-count + " / " + root.discover-items.length; color: Palette.alternate-foreground; vertical-alignment: center; font-size: 12px; }
                }
                ListView { vertical-stretch: 1;
                    for option in root.discover-items: Rectangle {
                        height: 48px;
                        Rectangle {
                            y: 2px; width: parent.width; height: 44px; border-radius: Theme.radius-md;
                            background: option.checked ? Theme.selection : disc-hit.has-hover ? Theme.hover : transparent;
                            animate background { duration: 100ms; easing: ease-out; }
                            HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Rectangle {
                                    width: 16px; height: 16px; y: 14px; border-radius: Theme.radius-sm; border-width: 1px;
                                    border-color: option.checked || disc-hit.has-hover ? Palette.accent-background : Theme.stroke;
                                    background: option.checked ? Palette.accent-background : Theme.surface;
                                    animate background, border-color { duration: 120ms; easing: ease-out; }
                                    if option.checked: Image { x: 2px; y: 2px; width: 12px; height: 12px; source: @image-url("icons/check.svg"); colorize: Palette.accent-foreground; accessible-role: none; }
                                }
                                VerticalLayout { spacing: 1px; alignment: center;
                                    Text { text: option.name; color: Palette.foreground; overflow: elide; }
                                    Text { text: option.detail; color: Palette.alternate-foreground; font-size: 11px; overflow: elide; }
                                }
                            }
                            disc-hit := TouchArea { clicked => { root.discover-toggle(option.index); } }
                            Tooltip { HintSurface { title: option.name; detail: option.detail; } }
                        }
                    }
                }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: I18n.en ? "Cancel" : "取消"; clicked => { root.discover-open = false; root.focus-browser(); } }
                    Button { text: I18n.en ? "Import selected" : "导入所选"; primary: true; enabled: !root.discover-loading && root.discover-selected-count > 0; clicked => { root.discover-import(); } }
                }
            }
        }
    }
    if root.broken-open: Rectangle { background: Theme.scrim; TouchArea { }
        Rectangle {
            x: 16px; y: 48px; width: parent.width - 32px; height: parent.height - 68px;
            background: Theme.elevated; border-width: 1px; border-color: Theme.stroke; border-radius: Theme.radius-lg;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            VerticalLayout { padding: 14px; spacing: 10px;
                Text { text: I18n.en ? "Broken item check" : "失效项目检查"; font-size: 16px; font-weight: 600; color: Palette.foreground; }
                Text { text: root.broken-loading ? (I18n.en ? "Checking local paths and installed apps…" : "正在检查本地路径与已安装应用…") : root.broken-items.length == 0 ? (I18n.en ? "All local paths and app targets are valid." : "所有本地路径与应用目标均有效。") : (I18n.en ? "Found " + root.broken-items.length + (root.broken-items.length == 1 ? " broken target (URLs skipped):" : " broken targets (URLs skipped):") : "发现 " + root.broken-items.length + " 个失效目标（未检查网页地址）："); color: Palette.alternate-foreground; font-size: 12px; wrap: word-wrap; }
                ListView { vertical-stretch: 1;
                    for item in root.broken-items: Rectangle {
                        height: 68px;
                        Rectangle {
                            y: 2px; width: parent.width; height: 64px; border-radius: Theme.radius-md; background: Theme.navigation;
                            HorizontalLayout { padding: 8px; spacing: 8px;
                                VerticalLayout { horizontal-stretch: 1; spacing: 2px; alignment: center;
                                    Text { text: item.name; color: Palette.foreground; font-weight: 600; overflow: elide; }
                                    Text { text: item.target; color: Palette.alternate-foreground; font-size: 11px; overflow: elide; }
                                    Text { text: item.reason; color: Theme.danger; font-size: 11px; overflow: elide; }
                                }
                                HorizontalLayout { spacing: 4px; y: 12px; height: 32px;
                                    if item.relocatable: Button { text: I18n.en ? "Relocate" : "重定位"; clicked => { root.broken-relocate(item.id); } }
                                    Button { text: I18n.en ? "Edit" : "编辑"; clicked => { root.broken-edit(item.id); } }
                                    Button { text: I18n.en ? "Remove" : "移除"; clicked => { root.broken-remove(item.id); } }
                                }
                            }
                            Tooltip { HintSurface { title: item.name; detail: item.target; notes: item.reason; } }
                        }
                    }
                }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: I18n.en ? "Re-check" : "重新检查"; enabled: !root.broken-loading; clicked => { root.broken-check(); } }
                    Button { text: I18n.en ? "Close" : "关闭"; clicked => { root.broken-open = false; root.focus-browser(); } }
                }
            }
        }
    }
    if root.dock-edge >= 0 && root.edge-progress > 0.65 && root.edge-strip-size > 0px: Rectangle {
        x: root.dock-edge == 0 ? parent.width - root.edge-strip-size : 0px;
        y: root.dock-edge == 2 ? parent.height - root.edge-strip-size : 0px;
        width: root.dock-edge == 2 ? parent.width : root.edge-strip-size;
        height: root.dock-edge == 2 ? root.edge-strip-size : parent.height;
        opacity: min(1.0, (root.edge-progress - 0.65) / 0.35);
        background: Theme.navigation.mix(Palette.accent-background, 0.88);
        // Subtle 1phx outer stroke keeps even a 1px collapsed strip legible against white or dark backdrops.
        Rectangle {
            x: root.dock-edge == 0 ? parent.width - 1phx : 0px;
            y: root.dock-edge == 2 ? parent.height - 1phx : 0px;
            width: root.dock-edge == 2 ? parent.width : 1phx;
            height: root.dock-edge == 2 ? 1phx : parent.height;
            background: Theme.stroke.mix(Palette.accent-background, 0.55);
        }
        if root.edge-strip-size >= 3phx: Rectangle {
            property <length> thickness: min(2.5px, max(1phx, root.edge-strip-size - 2.5phx));
            x: root.dock-edge == 2 ? (parent.width - 36px) / 2
                : root.dock-edge == 0 ? (parent.width - 1phx - self.thickness) / 2
                : 1phx + (parent.width - 1phx - self.thickness) / 2;
            y: root.dock-edge == 2 ? (parent.height - 1phx - self.thickness) / 2 : (parent.height - 36px) / 2;
            width: root.dock-edge == 2 ? 36px : self.thickness;
            height: root.dock-edge == 2 ? self.thickness : 36px;
            border-radius: self.thickness / 2;
            background: Palette.accent-background.with-alpha(0.55);
        }
    }

}

export component EditorWindow inherits AppWindow {
    in-out property <bool> window-active <=> root.frame-active;
    in-out property <bool> topmost-window;
    in property <bool> editing;
    always-on-top: root.topmost-window;
    title: root.editing ? (I18n.en ? "Edit item" : "编辑项目") : (I18n.en ? "Add item" : "添加项目");
    preferred-width: 520px; preferred-height: 650px;
    min-width: 460px; min-height: 480px;
    in-out property <string> entry-name;
    in-out property <string> target;
    in-out property <string> aliases;
    in-out property <string> notes;
    in-out property <string> arguments;
    in-out property <string> working-dir;
    in-out property <bool> elevated;
    in-out property <int> show-mode;
    in-out property <int> kind;
    in-out property <int> collection-id;
    in property <string> collection-name;
    in property <[DestinationNode]> collection-nodes;
    in-out property <bool> collection-open;
    in-out property <int> collection-cursor;
    callback pick-collection;
    callback collection-node(int);
    callback collection-key(int);
    /// The installed-app list is an overlay on this form rather than a window of its own: it is
    /// only ever opened from here, and a separate top-level would keep its own backing surface
    /// alive for the rest of the session.
    in-out property <bool> picker-open;
    in property <[AppOption]> picker-shown;
    in-out property <string> picker-filter;
    in-out property <string> picker-aumid;
    in-out property <string> picker-name;
    callback picker-refilter;
    callback picker-confirm(string, string);
    in-out property <string> error;

    in-out property <bool> discard-confirm;
    in property <image> entry-icon;
    in property <bool> saving;
    in property <bool> composing;
    callback icon-path(string); callback pick-app;
    callback browse-icon; callback reset-icon; callback convert-path(bool);
    callback save; callback cancel; callback discard; callback keep-editing; callback browse; callback browse-working-dir;
    public function focus-name() { name-input.focus(); name-input.select-all(); }
    public function focus-picker-filter() { picker-filter-input.focus(); picker-filter-input.select-all(); }
    public function focus-collection-tree() { collection-tree.focus-tree(); }
    VerticalLayout {
        spacing: 0px;
        TitleBar { title: root.editing ? (I18n.en ? "Edit item" : "编辑项目") : (I18n.en ? "Add item" : "添加项目"); close => { root.cancel(); } }
        Rectangle { background: Theme.surface;
            VerticalLayout { padding: 20px; spacing: 12px;
                ScrollView { content-width: self.visible-width;
                    VerticalLayout { padding-right: 8px; spacing: 10px; alignment: start;
                        HorizontalLayout { spacing: 12px;
                            Text { width: I18n.en ? 84px : 64px; text: I18n.en ? "Name" : "名称"; color: Palette.foreground; vertical-alignment: center; }
                            name-input := LineEdit { enabled: !root.saving; text <=> root.entry-name; placeholder-text: I18n.en ? "Item name" : "项目名称"; accessible-label: I18n.en ? "Name" : "名称"; accepted => { if !root.composing { root.save(); } } }
                        }
                        HorizontalLayout { spacing: 12px; alignment: start;
                            Text { width: I18n.en ? 84px : 64px; text: I18n.en ? "Icon" : "图标"; color: Palette.foreground; vertical-alignment: center; }
                            Image {
                                width: 40px; height: 40px;
                                source: root.entry-icon.width > 0 ? root.entry-icon : root.kind == 2 ? @image-url("icons/folder.svg") : root.kind == 3 ? @image-url("icons/web.svg") : root.kind == 1 ? @image-url("icons/file.svg") : root.kind == 5 ? @image-url("icons/app.svg") : @image-url("icons/program.svg");
                                colorize: root.entry-icon.width > 0 ? #0000 : (root.kind == 2 ? #b68422 : root.kind == 3 ? #278879 : root.kind == 5 ? #8065b9 : Palette.accent-background);
                            }
                            Button { text: I18n.en ? "Choose icon" : "选择图标"; clicked => { root.browse-icon(); } }
                            Button { text: root.kind == 3 ? (I18n.en ? "Fetch web icon" : "提取网页图标") : root.kind == 5 ? (I18n.en ? "Extract app icon" : "提取应用图标") : (I18n.en ? "Extract from target" : "从目标提取"); clicked => { root.reset-icon(); } }
                        }
                        HorizontalLayout { spacing: 12px;
                            VerticalLayout { width: 132px; spacing: 6px;
                                Text { text: I18n.en ? "Type" : "类型"; color: Palette.alternate-foreground; font-size: 12px; }
                                SettingsSelect { min-width: 0px; model: I18n.en ? ["Program", "File", "Folder", "URL", "Shortcut", "App AUMID"] : ["程序", "文件", "文件夹", "网址", "快捷方式", "应用 AUMID"]; current-index <=> root.kind; accessible-name: I18n.en ? "Target type" : "目标类型"; }
                            }
                            VerticalLayout { spacing: 6px;
                                Text { text: I18n.en ? "Category" : "所属分类"; color: Palette.alternate-foreground; font-size: 12px; }
                                Button { text: root.collection-name; enabled: !root.collection-open; clicked => { root.pick-collection(); } }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.stroke; }
                        HorizontalLayout { spacing: 12px;
                            Text { width: I18n.en ? 84px : 64px; text: root.kind == 5 ? (I18n.en ? "App ID" : "应用标识") : root.kind == 3 ? (I18n.en ? "URL" : "网址") : (I18n.en ? "Target path" : "目标路径"); color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { text <=> root.target; enabled: root.kind != 5; accessible-label: I18n.en ? "Target" : "目标"; placeholder-text: root.kind == 3 ? (I18n.en ? "https://example.com or example.com" : "https://example.com 或 example.com") : root.kind == 5 ? (I18n.en ? "Choose from app list" : "从下方应用列表选择") : (I18n.en ? "Choose or enter target" : "选择或输入目标"); accepted => { if !root.composing { root.save(); } } }
                            if root.kind == 5: IconButton { icon: @image-url("icons/app.svg"); label: I18n.en ? "Choose from installed apps" : "从应用列表选择"; clicked => { root.pick-app(); } }
                            if root.kind != 3 && root.kind != 5: IconButton { icon: @image-url("icons/folder.svg"); label: I18n.en ? "Browse target" : "选择目标"; clicked => { root.browse(); } }
                        }
                        if root.kind != 3 && root.kind != 5: HorizontalLayout { padding-left: I18n.en ? 96px : 76px; alignment: start; spacing: 8px;
                            Button { text: I18n.en ? "To relative path" : "转为相对路径"; clicked => { root.convert-path(true); } }
                            Button { text: I18n.en ? "To absolute path" : "转为绝对路径"; clicked => { root.convert-path(false); } }
                        }
                        if root.kind == 0: HorizontalLayout { spacing: 12px;
                            Text { width: I18n.en ? 84px : 64px; text: I18n.en ? "Arguments" : "参数"; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { text <=> root.arguments; accessible-label: I18n.en ? "Arguments" : "参数"; accepted => { if !root.composing { root.save(); } } }
                        }
                        if root.kind == 0: HorizontalLayout { spacing: 12px;
                            Text { width: I18n.en ? 84px : 64px; text: I18n.en ? "Working dir" : "工作目录"; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { text <=> root.working-dir; accessible-label: I18n.en ? "Working directory" : "工作目录"; accepted => { if !root.composing { root.save(); } } }
                            IconButton { icon: @image-url("icons/folder.svg"); label: I18n.en ? "Browse working directory" : "选择工作目录"; clicked => { root.browse-working-dir(); } }
                        }
                        if root.kind == 0: HorizontalLayout { padding-left: I18n.en ? 96px : 76px; alignment: start;
                            CheckBox { text: I18n.en ? "Run as administrator" : "以管理员身份运行"; checked <=> root.elevated; }
                        }
                        if root.kind == 0 || root.kind == 4: HorizontalLayout { spacing: 12px;
                            Text { width: I18n.en ? 84px : 64px; text: I18n.en ? "Run mode" : "打开方式"; color: Palette.foreground; vertical-alignment: center; }
                            SettingsSelect { horizontal-stretch: 1; model: I18n.en ? ["Normal", "Maximized", "Minimized"] : ["普通", "最大化", "最小化"]; current-index <=> root.show-mode; accessible-name: I18n.en ? "Run mode" : "打开方式"; }
                        }
                        Rectangle { height: 1px; background: Theme.stroke; }
                        HorizontalLayout { spacing: 12px;
                            Text { width: I18n.en ? 84px : 64px; text: I18n.en ? "Aliases" : "别名"; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { text <=> root.aliases; accessible-label: I18n.en ? "Aliases" : "别名"; placeholder-text: I18n.en ? "Keywords for search" : "用于搜索"; accepted => { if !root.composing { root.save(); } } }
                        }
                        HorizontalLayout { spacing: 12px;
                            Text { width: I18n.en ? 84px : 64px; height: 24px; text: I18n.en ? "Notes" : "备注"; color: Palette.foreground; vertical-alignment: center; }
                            TextEdit { height: 76px; text <=> root.notes; wrap: word-wrap; }
                        }
                    }
                }
                if root.error != "": Text { text: root.error; color: Palette.foreground; wrap: word-wrap; }
            }
        }
        Rectangle { height: 1px; background: Theme.stroke; }
        HorizontalLayout { padding: 16px; spacing: 8px; alignment: end;
            Button { text: I18n.en ? "Cancel" : "取消"; clicked => { root.cancel(); } }
            Button { text: root.saving ? (I18n.en ? "Saving…" : "正在保存…") : root.editing ? (I18n.en ? "Save" : "保存") : (I18n.en ? "Add" : "添加"); enabled: !root.saving; primary: true; clicked => { root.save(); } }
        }
    }
    if root.discard-confirm: Rectangle { background: Theme.scrim; TouchArea { }
        Rectangle { x: 24px; width: parent.width - 48px; height: discard-form.preferred-height; y: (parent.height - self.height) / 2; background: Theme.elevated; border-radius: Theme.radius-lg; border-width: 1px; border-color: Theme.stroke; drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            discard-form := VerticalLayout { padding: 20px; spacing: 16px;
                Text { text: I18n.en ? "Discard unsaved changes?" : "放弃未保存的更改？"; font-size: 18px; font-weight: 600; color: Palette.foreground; }
                Text { text: I18n.en ? "Closing now will discard your edits." : "关闭后将丢失本次编辑的内容。"; color: Palette.alternate-foreground; wrap: word-wrap; }
                HorizontalLayout { spacing: 8px; alignment: end;
                    Button { text: I18n.en ? "Keep editing" : "继续编辑"; clicked => { root.discard-confirm = false; root.keep-editing(); } }
                    Button { text: I18n.en ? "Discard" : "放弃更改"; clicked => { root.discard(); } }
                }
            }
        }
    }
    // `visible:` rather than `if`, so `focus-collection-tree` can reach `collection-tree`.
    Rectangle {
        visible: root.collection-open || self.opacity > 0.01;
        opacity: root.collection-open ? 1 : 0;
        animate opacity { duration: 150ms; easing: ease-out; }
        background: Theme.scrim;
        TouchArea { enabled: root.collection-open; }
        Rectangle {
            x: 24px; y: root.collection-open ? 48px : 56px; width: parent.width - 48px; height: parent.height - 96px;
            animate y { duration: 150ms; easing: ease-out; }
            background: Theme.elevated; border-radius: Theme.radius-lg; border-width: 1px; border-color: Theme.stroke;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            VerticalLayout { padding: 14px; spacing: 10px;
                Text { text: I18n.en ? "Choose category" : "选择所属分类"; font-size: 16px; font-weight: 600; color: Palette.foreground; }
                collection-tree := NavTree {
                    nodes: root.collection-nodes; selected: root.collection-id; cursor: root.collection-cursor;
                    pick(id) => { root.collection-node(id); }
                    key(delta) => { root.collection-key(delta); }
                }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: I18n.en ? "Cancel" : "取消"; clicked => { root.collection-open = false; root.focus-name(); } }
                }
            }
        }
    }
    // `visible:` rather than `if`, so `focus-picker-filter` can reach the LineEdit id.
    Rectangle {
        visible: root.picker-open || self.opacity > 0.01;
        opacity: root.picker-open ? 1 : 0;
        animate opacity { duration: 150ms; easing: ease-out; }
        background: Theme.scrim;
        TouchArea { enabled: root.picker-open; }
        Rectangle {
            x: 24px; y: root.picker-open ? 48px : 56px; width: parent.width - 48px; height: parent.height - 96px;
            animate y { duration: 150ms; easing: ease-out; }
            background: Theme.elevated; border-radius: Theme.radius-lg; border-width: 1px; border-color: Theme.stroke;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            VerticalLayout { padding: 14px; spacing: 10px;
                Text { text: I18n.en ? "Choose installed app" : "选择已安装应用"; font-size: 16px; font-weight: 600; color: Palette.foreground; }
                picker-filter-input := LineEdit { text <=> root.picker-filter; placeholder-text: I18n.en ? "Filter by name" : "按名称筛选"; accessible-label: I18n.en ? "Filter by name" : "按名称筛选"; changed text => { root.picker-refilter(); } }
                ListView { vertical-stretch: 1;
                    for option in root.picker-shown: Rectangle {
                        height: 46px;
                        Rectangle {
                            y: 2px; width: parent.width; height: 44px; border-radius: Theme.radius-md;
                            background: option.aumid == root.picker-aumid ? Theme.selection : app-hit.has-hover ? Theme.hover : transparent;
                            animate background { duration: 100ms; easing: ease-out; }
                            accessible-role: button; accessible-label: option.name;
                            accessible-action-default => { root.picker-aumid = option.aumid; root.picker-name = option.name; }
                            VerticalLayout { padding-left: 8px; spacing: 0px; alignment: center;
                                Text { text: option.name; color: Palette.foreground; overflow: elide; }
                                Text { text: option.aumid; color: Palette.alternate-foreground; font-size: 11px; overflow: elide; }
                            }
                            app-hit := TouchArea {
                                clicked => { root.picker-aumid = option.aumid; root.picker-name = option.name; }
                                double-clicked => { root.picker-confirm(option.aumid, option.name); }
                            }
                            Tooltip { HintSurface { title: option.aumid; } }
                        }
                    }
                }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: I18n.en ? "Cancel" : "取消"; clicked => { root.picker-open = false; root.focus-name(); } }
                    Button { text: I18n.en ? "Add" : "添加"; enabled: root.picker-aumid != ""; clicked => { root.picker-confirm(root.picker-aumid, root.picker-name); } }
                }
            }
        }
    }

}

export component SettingsWindow inherits AppWindow {
    in property <string> app-version;
    in property <string> rust-version;
    in property <bool> composing;
    in-out property <bool> legal-open;
    in-out property <int> legal-tab;
    in property <[string]> license-lines;
    in property <[NoticeItem]> notice-items;
    in-out property <bool> window-active <=> root.frame-active;
    in-out property <bool> topmost-window;
    always-on-top: root.topmost-window;
    title: I18n.en ? "Settings · Raptim" : "设置 · Raptim";
    preferred-width: 660px; preferred-height: 480px;
    min-width: 580px; min-height: 400px;
    in-out property <string> hotkey-text: "Ctrl+Alt+Space";
    in-out property <bool> recording-hotkey;
    in-out property <string> hotkey-error;
    callback record-hotkey; callback reset-hotkey; callback captured-hotkey(string);
    in-out property <int> page;
    in-out property <int> theme-mode: 0;
    in-out property <int> language-mode: 0;
    in-out property <bool> autostart;
    in property <string> autostart-warning;
    in-out property <bool> double-click;
    in-out property <bool> type-to-search;
    in-out property <bool> edge-hide;
    in-out property <bool> edge-strip-visible: true;
    in-out property <int> edge-strip-width: 1;
    in-out property <int> edge-collapse-delay: 250;
    in-out property <bool> hide-on-focus-loss;
    in-out property <bool> hover-switch;
    in-out property <int> hover-delay: 350;
    in-out property <bool> relative-paths;
    in-out property <bool> hide-after-launch;
    in-out property <bool> fullscreen-protection;
    in-out property <bool> protection-log;
    in-out property <bool> protection-bypass;
    callback protection-bypass-changed(bool);
    in-out property <bool> keep-topmost;
    in-out property <[string]> protected-apps;
    in-out property <string> protected-input;
    in-out property <string> protected-error;
    in property <string> data-path;
    in property <bool> has-error-log;
    in-out property <string> status;
    in-out property <bool> restore-confirm;
    callback open-rust; callback open-slint; callback open-repo; callback open-issues; callback open-changelog;
    callback copy-env-info; callback copy-license;
    callback change(int); callback browse-game; callback add-protected-app(string); callback remove-protected-app(int); callback export-data; callback import-data;
    callback confirm-restore; callback cancel; callback restore-position; callback open-data-dir; callback open-error-log;
    changed page => { settings-scroll.content-y = 0px; }
    VerticalLayout {
        padding: 0px; spacing: 0px;
        TitleBar { title: I18n.en ? "Settings" : "设置"; close => { root.cancel(); } }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: I18n.en ? 156px : 140px; horizontal-stretch: 0; background: Theme.navigation;
                VerticalLayout { padding: 10px; spacing: 4px; alignment: start;
                    for name[index] in (I18n.en ? ["General", "Summon & Hide", "Game DND", "Data", "About"] : ["常规", "呼出与隐藏", "游戏勿扰", "数据", "关于"]): Rectangle {
                        height: 36px; border-radius: Theme.radius-md;
                        background: root.page == index ? Theme.selection : nav-touch.has-hover ? Theme.hover : transparent;
                        animate background { duration: 100ms; easing: ease-out; }
                        border-width: nav-focus.has-focus ? 1px : 0px;
                        border-color: Palette.accent-background;
                        accessible-role: button; accessible-label: name; accessible-action-default => { root.page = index; }
                        if root.page == index: Rectangle { x: 0px; y: 9px; height: 18px; width: 3px; border-radius: 1.5px; background: Palette.accent-background; }
                        Text { x: 12px; width: parent.width - 20px; height: parent.height; text: name; vertical-alignment: center; font-weight: root.page == index ? 600 : 400; color: root.page == index ? Palette.accent-background : Palette.foreground; overflow: elide; }
                        nav-focus := FocusScope { x: 0px; width: 0px; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.page = index; return accept; } return reject; } }
                        nav-touch := TouchArea { clicked => { root.page = index; } }
                    }
                }
            }
            Rectangle { width: 1px; horizontal-stretch: 0; background: Theme.subtle-stroke; }
            Rectangle { horizontal-stretch: 1; background: Theme.surface;
                VerticalLayout {
                    padding: 0px; spacing: 0px;
                    settings-scroll := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        VerticalLayout {
                            padding-left: 24px; padding-right: 24px;
                            padding-top: 12px; padding-bottom: 20px;
                            spacing: 0px; alignment: start;
                            if root.page == 0: SettingRow { label: I18n.en ? "Theme" : "外观主题";
                                SettingsSelect {
                                    width: 150px; accessible-name: I18n.en ? "Theme" : "外观主题";
                                    model: I18n.en ? ["Follow system", "Light", "Dark"] : ["跟随系统", "浅色", "深色"];
                                    current-index <=> root.theme-mode;
                                    selected(value) => { root.change(0); }
                                }
                            }
                            if root.page == 0: SettingRow { label: I18n.en ? "Language" : "界面语言";
                                SettingsSelect {
                                    width: 150px; accessible-name: I18n.en ? "Language" : "界面语言";
                                    model: I18n.en ? ["Follow system", "简体中文", "English"] : ["跟随系统", "简体中文", "English"];
                                    current-index <=> root.language-mode;
                                    selected(value) => { root.change(0); }
                                }
                            }
                            if root.page == 0: SettingRow { label: I18n.en ? "Launch at startup" : "开机启动"; divider: root.autostart-warning == "";
                                Switch { height: 32px; checked <=> root.autostart; toggled => { root.change(0); } }
                            }
                            if root.page == 0 && root.autostart-warning != "": VerticalLayout {
                                padding-bottom: 10px; spacing: 8px;
                                Rectangle { border-radius: Theme.radius-md; background: Theme.navigation; border-width: 1px; border-color: Theme.danger;
                                    HorizontalLayout { padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 8px;
                                        Text { text: root.autostart-warning; wrap: word-wrap; color: Theme.danger; font-size: 12px; }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.stroke; }
                            }
                            if root.page == 0: SettingRow { label: I18n.en ? "Hide after launch" : "打开项目后隐藏";
                                Switch { height: 32px; checked <=> root.hide-after-launch; toggled => { root.change(0); } }
                            }
                            if root.page == 0: SettingRow { label: I18n.en ? "Launch click" : "启动方式";
                                SettingsSelect {
                                    width: 150px; accessible-name: I18n.en ? "Launch click" : "启动方式";
                                    model: I18n.en ? ["Single click", "Double click"] : ["单击", "双击"];
                                    current-index: root.double-click ? 1 : 0;
                                    selected(value) => { root.double-click = self.current-index == 1; root.change(0); }
                                }
                            }
                            if root.page == 0: SettingRow { label: I18n.en ? "Type to search when focused" : "获焦后直接打字搜索";
                                Switch { height: 32px; checked <=> root.type-to-search; toggled => { root.change(0); } }
                            }
                            if root.page == 0: SettingRow { label: I18n.en ? "Switch categories on hover" : "悬停切换分类"; divider: root.hover-switch;
                                Switch { height: 32px; checked <=> root.hover-switch; toggled => { root.change(0); } }
                            }
                            if root.page == 0 && root.hover-switch: SettingRow { label: I18n.en ? "Hover delay" : "悬停延迟"; divider: false;
                                SettingsSelect {
                                    width: 150px; accessible-name: I18n.en ? "Hover delay" : "悬停延迟";
                                    model: ["200 ms", "350 ms", "600 ms"];
                                    current-index: root.hover-delay == 200 ? 0 : root.hover-delay == 600 ? 2 : 1;
                                    selected(value) => { root.hover-delay = self.current-index == 0 ? 200 : self.current-index == 2 ? 600 : 350; root.change(0); }
                                }
                            }

                            if root.page == 1: SettingRow { label: I18n.en ? "Global hotkey" : "呼出热键"; control-width: 288px; divider: root.hotkey-error == "";
                                Button { width: 192px; height: 32px; text: root.recording-hotkey ? (I18n.en ? "Press shortcut · Esc to cancel" : "请按组合键 · Esc 取消") : root.hotkey-text; clicked => { root.record-hotkey(); } }
                                Button { width: 88px; height: 32px; text: I18n.en ? "Reset" : "恢复默认"; clicked => { root.reset-hotkey(); } }
                            }
                            if root.page == 1 && root.hotkey-error != "": VerticalLayout {
                                padding-bottom: 10px; spacing: 8px;
                                Text { text: root.hotkey-error; wrap: word-wrap; color: Theme.danger; font-size: 12px; }
                                Rectangle { height: 1px; background: Theme.stroke; }
                            }
                            if root.page == 1: SettingRow { label: I18n.en ? "Auto-hide at screen edge" : "贴边自动收纳";
                                Switch { height: 32px; checked <=> root.edge-hide; toggled => { root.change(0); } }
                            }
                            if root.page == 1: SettingRow { label: I18n.en ? "Show edge strip" : "显示露边"; enabled: root.edge-hide;
                                Switch { height: 32px; enabled: root.edge-hide; checked <=> root.edge-strip-visible; toggled => { root.change(0); } }
                            }
                            if root.page == 1: SettingRow {
                                label: I18n.en ? "Edge strip width" : "露边宽度";
                                description: I18n.en ? "Physical pixels; hovering the edge still expands when off" : "物理像素；关闭后悬停边缘仍可展开";
                                control-width: 228px;
                                enabled: root.edge-hide && root.edge-strip-visible;
                                Slider { enabled: root.edge-hide && root.edge-strip-visible; width: 108px; height: 32px; minimum: 1; maximum: 12; value: root.edge-strip-width; changed(value) => { root.edge-strip-width = round(value); root.change(0); } }
                                HorizontalLayout { width: 112px; height: 32px; spacing: 4px;
                                    StepperButton { text: "−"; label: I18n.en ? "Decrease strip width" : "减小露边宽度"; enabled: root.edge-hide && root.edge-strip-visible && root.edge-strip-width > 1; clicked => { root.edge-strip-width -= 1; root.change(0); } }
                                    PixelWidthInput { value <=> root.edge-strip-width; enabled: root.edge-hide && root.edge-strip-visible; edited => { root.change(0); } }
                                    StepperButton { text: "+"; label: I18n.en ? "Increase strip width" : "增大露边宽度"; enabled: root.edge-hide && root.edge-strip-visible && root.edge-strip-width < 12; clicked => { root.edge-strip-width += 1; root.change(0); } }
                                }
                            }
                            if root.page == 1: SettingRow { label: I18n.en ? "Edge collapse delay" : "贴边收起延迟"; enabled: root.edge-hide;
                                SettingsSelect {
                                    width: 150px; enabled: root.edge-hide; accessible-name: I18n.en ? "Edge collapse delay" : "贴边收起延迟";
                                    model: ["150 ms", "250 ms", "450 ms"];
                                    current-index: root.edge-collapse-delay <= 150 ? 0 : root.edge-collapse-delay >= 450 ? 2 : 1;
                                    selected(value) => { root.edge-collapse-delay = self.current-index == 0 ? 150 : self.current-index == 2 ? 450 : 250; root.change(0); }
                                }
                            }
                            if root.page == 1: SettingRow { label: I18n.en ? "Always on top" : "窗口始终置顶";
                                Switch { height: 32px; checked <=> root.keep-topmost; toggled => { root.change(3); } }
                            }
                            if root.page == 1: SettingRow { label: I18n.en ? "Hide on focus loss" : "失去焦点时隐藏";
                                Switch { height: 32px; checked <=> root.hide-on-focus-loss; toggled => { root.change(0); } }
                            }
                            if root.page == 1: SettingRow { label: I18n.en ? "Window position off-screen?" : "主窗口位置异常"; divider: false;
                                Button { width: 150px; height: 32px; text: I18n.en ? "Reset position" : "恢复窗口位置"; clicked => { root.restore-position(); } }
                            }

                            if root.page == 2: SettingRow { label: I18n.en ? "Fullscreen protection" : "全屏保护";
                                Switch { height: 32px; checked <=> root.fullscreen-protection; toggled => { root.change(0); } }
                            }
                            if root.page == 2: SettingRow {
                                label: I18n.en ? "Pause Game DND" : "暂停游戏勿扰";
                                description: I18n.en ? "Applies to this session only: hotkeys, tray, and edge summon remain active until exit" : "仅本次运行有效：暂停期间热键、托盘与贴边呼出恢复可用，退出后自动恢复判定";
                                control-width: 56px;
                                Switch { height: 32px; checked: root.protection-bypass; toggled => { root.protection-bypass-changed(!root.protection-bypass); } }
                            }
                            if root.page == 2: SettingRow {
                                label: I18n.en ? "Log protection decisions" : "记录保护判定";
                                description: I18n.en ? "Saves foreground app, notification state, and blocked requests in the data dir (check paths before sharing)" : "记录前台应用、通知状态与被阻止的呼出请求，保存于数据目录（含本地路径，分享前请检查）";
                                control-width: 56px;
                                Switch { height: 32px; checked <=> root.protection-log; toggled => { root.change(0); } }
                            }
                            if root.page == 2: VerticalLayout {
                                padding-top: 14px; spacing: 10px;
                                HorizontalLayout { spacing: 8px;
                                    Text { text: I18n.en ? "Strict protected apps" : "严格保护程序"; font-weight: 600; font-size: 14px; color: Palette.foreground; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.protected-apps.length + " / 100"; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                                }
                                HorizontalLayout { spacing: 8px; height: 32px;
                                    LineEdit { text <=> root.protected-input; placeholder-text: I18n.en ? "Enter full executable path" : "输入程序完整路径"; horizontal-stretch: 1;
                                        accessible-label: I18n.en ? "Strict protected app path" : "严格保护程序路径";
                                        accepted(text) => { if !root.composing { root.add-protected-app(text); } } }
                                    Button { width: 68px; height: 32px; text: I18n.en ? "Add" : "添加"; clicked => { root.add-protected-app(root.protected-input); } }
                                    IconButton { icon: @image-url("icons/folder.svg"); label: I18n.en ? "Browse game executable" : "选择游戏程序"; clicked => { root.browse-game(); } }
                                }
                                if root.protected-error != "": Text { text: root.protected-error; wrap: word-wrap; color: Theme.danger; font-size: 12px; }
                                if root.protected-apps.length == 0: Rectangle {
                                    height: 44px; border-radius: Theme.radius-md; background: Theme.navigation; border-width: 1px; border-color: Theme.stroke;
                                    HorizontalLayout { padding-left: 12px; padding-right: 12px;
                                        Text { text: I18n.en ? "No strict protected apps added" : "尚未添加严格保护的程序"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                    }
                                }
                                if root.protected-apps.length > 0: Rectangle {
                                    border-radius: Theme.radius-md; background: Palette.background; border-width: 1px; border-color: Theme.stroke;
                                    VerticalLayout { padding: 4px; spacing: 2px; alignment: start;
                                        for path[index] in root.protected-apps: Rectangle {
                                            height: 34px; border-radius: Theme.radius-sm;
                                            background: protected-row-touch.has-hover ? Theme.hover : transparent;
                                            animate background { duration: 100ms; easing: ease-out; }
                                            HorizontalLayout { padding-left: 8px; padding-right: 2px; spacing: 6px;
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    protected-row-touch := TouchArea { }
                                                    Text { width: parent.width; height: parent.height; text: path; font-size: 13px; vertical-alignment: center; overflow: elide; color: Palette.foreground; }
                                                    Tooltip { HintSurface { title: path; } }
                                                }
                                                IconButton { y: 1px; icon: @image-url("icons/close.svg"); label: (I18n.en ? "Remove " : "移除 ") + path; width: 32px; height: 32px; clicked => { root.remove-protected-app(index); } }
                                            }
                                        }
                                    }
                                }
                                Text { text: I18n.en ? "Strict protection activates whenever a foreground window matches any listed path (up to 100 entries)." : "前台窗口命中任一路径即进入严格保护，最多可添加 100 项。"; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
                            }

                            if root.page == 3: VerticalLayout { spacing: 0px;
                                VerticalLayout { padding-top: 4px; padding-bottom: 14px; spacing: 8px;
                                    Text { text: I18n.en ? "Data directory" : "数据目录"; font-weight: 600; font-size: 14px; color: Palette.foreground; }
                                    Rectangle { border-radius: Theme.radius-md; background: Theme.navigation; border-width: 1px; border-color: Theme.stroke;
                                        HorizontalLayout { padding-left: 12px; padding-right: 12px; padding-top: 9px; padding-bottom: 9px;
                                            Text { text: root.data-path; font-size: 13px; wrap: char-wrap; color: Palette.foreground; }
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.stroke; }
                                SettingRow {
                                    label: I18n.en ? "Prefer relative paths for new items" : "新增项目优先使用相对路径";
                                    description: I18n.en ? "Stores program and working dir paths relative to the data directory for portable setups" : "以数据目录为基准保存程序路径与工作目录，便于便携迁移";
                                    control-width: 56px;
                                    Switch { height: 32px; checked <=> root.relative-paths; toggled => { root.change(0); } }
                                }
                                VerticalLayout { padding-top: 14px; spacing: 12px;
                                    Text { text: I18n.en ? "Data management" : "数据管理"; font-weight: 600; font-size: 14px; color: Palette.foreground; }
                                    HorizontalLayout { spacing: 8px; alignment: start;
                                        Button { min-width: 72px; height: 32px; text: I18n.en ? "Export" : "导出"; clicked => { root.export-data(); } }
                                        Button { min-width: 72px; height: 32px; text: I18n.en ? "Restore" : "恢复"; clicked => { root.import-data(); } }
                                        Button { height: 32px; text: I18n.en ? "Open data folder" : "打开数据目录"; clicked => { root.open-data-dir(); } }
                                        if root.has-error-log: Button { height: 32px; text: I18n.en ? "View error log" : "查看错误日志"; clicked => { root.open-error-log(); } }
                                    }
                                    if root.restore-confirm: Rectangle {
                                        border-radius: Theme.radius-md; background: Theme.navigation; border-width: 1px; border-color: Theme.stroke;
                                        VerticalLayout { padding: 12px; spacing: 10px;
                                            Text { text: I18n.en ? "Replace current data? Please back up your data directory first." : "替换当前数据？请先自行备份数据目录。"; wrap: word-wrap; color: Palette.foreground; }
                                            HorizontalLayout { spacing: 8px; alignment: start;
                                                Button { min-width: 72px; height: 32px; primary: true; text: I18n.en ? "Restore" : "恢复"; clicked => { root.confirm-restore(); } }
                                                Button { min-width: 72px; height: 32px; text: I18n.en ? "Cancel" : "取消"; clicked => { root.restore-confirm = false; } }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.page == 4: VerticalLayout { padding-top: 6px; spacing: 14px; alignment: start;
                                HorizontalLayout { spacing: 14px; alignment: start;
                                    VerticalLayout { alignment: center;
                                        Image { width: 48px; height: 48px; source: @image-url("icons/raptim.svg"); }
                                    }
                                    VerticalLayout { alignment: center; spacing: 3px; horizontal-stretch: 1;
                                        HorizontalLayout { spacing: 8px; alignment: start;
                                            Text { text: "Raptim"; font-size: 22px; font-weight: 600; color: Palette.foreground; vertical-alignment: center; }
                                            Rectangle {
                                                y: 4px; height: 22px; border-radius: Theme.radius-sm; background: Theme.navigation; border-width: 1px; border-color: Theme.stroke;
                                                HorizontalLayout { padding-left: 8px; padding-right: 8px;
                                                    Text { text: "v" + root.app-version; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                        Text { text: I18n.en ? "Lightweight local launcher for Windows" : "面向 Windows 的轻量本地启动器"; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                    }
                                }
                                HorizontalLayout { spacing: 8px; alignment: start;
                                    Button { height: 30px; text: I18n.en ? "GitHub" : "GitHub 仓库"; clicked => { root.open-repo(); } }
                                    Button { height: 30px; text: I18n.en ? "Issues" : "反馈问题"; clicked => { root.open-issues(); } }
                                    Button { height: 30px; text: I18n.en ? "Changelog" : "更新日志"; clicked => { root.open-changelog(); } }
                                    Button { height: 30px; text: I18n.en ? "Copy env info" : "复制环境信息"; clicked => { root.copy-env-info(); } }
                                }
                                Rectangle {
                                    border-radius: Theme.radius-md; background: Theme.navigation; border-width: 1px; border-color: Theme.stroke;
                                    VerticalLayout { padding: 12px; spacing: 8px;
                                        HorizontalLayout { spacing: 8px;
                                            Text { horizontal-stretch: 1; text: I18n.en ? "Copyright & License" : "版权与开源许可"; font-weight: 600; font-size: 13px; color: Palette.foreground; vertical-alignment: center; }
                                            Rectangle {
                                                height: 22px; border-radius: Theme.radius-sm; background: Theme.selection;
                                                HorizontalLayout { padding-left: 8px; padding-right: 8px;
                                                    Text { text: "GPL-3.0-only"; font-size: 11px; font-weight: 600; color: Palette.accent-background; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                        Text { text: "Copyright (C) 2026 KHWLGH"; font-size: 12px; color: Palette.foreground; }
                                        Text { text: I18n.en ? "Released under GNU General Public License v3.0 (GPL-3.0-only), provided as-is without any warranty." : "本软件基于 GNU General Public License v3.0（GPL-3.0-only）开源发布，按现状提供且不附带任何担保。"; wrap: word-wrap; font-size: 12px; color: Theme.muted; }
                                        HorizontalLayout { padding-top: 2px; spacing: 8px; alignment: start;
                                            Button { height: 30px; text: I18n.en ? "View license" : "查看开源许可证"; clicked => { root.legal-tab = 0; root.legal-open = true; } }
                                            Button { height: 30px; text: I18n.en ? "Third-party notices" : "第三方组件说明"; clicked => { root.legal-tab = 1; root.legal-open = true; } }
                                        }
                                    }
                                }
                                HorizontalLayout { spacing: 16px;
                                    Rectangle {
                                        preferred-width: 1px; horizontal-stretch: 1; height: 126px; border-radius: Theme.radius-md;
                                        background: rust-touch.has-hover ? Theme.hover : Theme.navigation;
                                        animate background { duration: 100ms; }
                                        border-width: 1px;
                                        border-color: rust-focus.has-focus ? Palette.accent-background : Theme.stroke;
                                        VerticalLayout { padding: 10px; spacing: 6px; alignment: center;
                                            HorizontalLayout { alignment: center; Image { width: 44px; height: 44px; source: @image-url("icons/rust.svg"); colorize: Palette.foreground; } }
                                            Text { text: "Version " + root.rust-version; horizontal-alignment: center; font-weight: 600; color: Palette.foreground; }
                                            Text { text: "https://www.rust-lang.org/"; horizontal-alignment: center; font-size: 12px; color: Theme.muted; }
                                        }
                                        accessible-role: button; accessible-label: I18n.en ? "Rust website" : "Rust 官网"; accessible-action-default => { root.open-rust(); }
                                        rust-focus := FocusScope { x: 0px; width: 0px; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.open-rust(); return accept; } return reject; } }
                                        rust-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-rust(); } }
                                        Tooltip { HintSurface { title: "https://www.rust-lang.org/"; } }
                                    }
                                    Rectangle {
                                        preferred-width: 1px; horizontal-stretch: 1; height: 126px; border-radius: Theme.radius-md;
                                        background: slint-touch.has-hover ? Theme.hover : Theme.navigation;
                                        animate background { duration: 100ms; }
                                        border-width: 1px;
                                        border-color: slint-focus.has-focus ? Palette.accent-background : Theme.stroke;
                                        VerticalLayout { padding: 4px; alignment: center;
                                            AboutSlint { height: 118px; }
                                        }
                                        accessible-role: button; accessible-label: I18n.en ? "Slint website" : "Slint 官网"; accessible-action-default => { root.open-slint(); }
                                        slint-focus := FocusScope { x: 0px; width: 0px; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.open-slint(); return accept; } return reject; } }
                                        slint-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-slint(); } }
                                        Tooltip { HintSurface { title: "https://slint.dev/"; } }
                                    }
                                }
                                Rectangle {
                                    border-radius: Theme.radius-md; background: Theme.navigation; border-width: 1px; border-color: Theme.stroke;
                                    VerticalLayout { padding: 12px; spacing: 6px;
                                        Text { text: I18n.en ? "Build & runtime" : "构建与运行信息"; font-weight: 600; font-size: 13px; color: Palette.foreground; }
                                        HorizontalLayout { spacing: 8px;
                                            Text { width: I18n.en ? 104px : 84px; text: I18n.en ? "App version" : "应用版本"; font-size: 12px; color: Theme.muted; }
                                            Text { horizontal-stretch: 1; text: root.app-version; font-size: 12px; color: Palette.foreground; overflow: elide; }
                                        }
                                        HorizontalLayout { spacing: 8px;
                                            Text { width: I18n.en ? 104px : 84px; text: I18n.en ? "Toolchain" : "编译工具链"; font-size: 12px; color: Theme.muted; }
                                            Text { horizontal-stretch: 1; text: "Rust " + root.rust-version; font-size: 12px; color: Palette.foreground; overflow: elide; }
                                        }
                                        HorizontalLayout { spacing: 8px;
                                            Text { width: I18n.en ? 104px : 84px; text: I18n.en ? "UI engine" : "界面引擎"; font-size: 12px; color: Theme.muted; }
                                            Text { horizontal-stretch: 1; text: I18n.en ? "Slint 1.18.0 (Fluent style, software renderer)" : "Slint 1.18.0（Fluent 样式，软件渲染）"; font-size: 12px; color: Palette.foreground; overflow: elide; }
                                        }
                                        HorizontalLayout { spacing: 8px;
                                            Text { width: I18n.en ? 104px : 84px; text: I18n.en ? "Storage" : "数据存储"; font-size: 12px; color: Theme.muted; }
                                            Text { horizontal-stretch: 1; text: I18n.en ? "Built-in SQLite (WAL mode)" : "内置 SQLite（WAL 模式）"; font-size: 12px; color: Palette.foreground; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                ToastBar {
                    x: 24px; width: parent.width - 48px;
                    container-height: parent.height;
                    bottom-offset: 14px;
                    text: root.status;
                    dismiss => { root.status = ""; }
                }
            }
        }
    }
    if root.legal-open: Rectangle {
        x: 0px; y: 0px; width: 100%; height: 100%;
        background: Theme.scrim;
        TouchArea { }
        Rectangle {
            x: 24px; y: 24px; width: parent.width - 48px; height: parent.height - 48px;
            background: Theme.elevated; border-radius: Theme.radius-lg; border-width: 1px; border-color: Theme.stroke;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
            VerticalLayout { padding: 16px; spacing: 10px;
                HorizontalLayout { spacing: 8px;
                    Button { height: 30px; primary: root.legal-tab == 0; text: I18n.en ? "GPL-3.0 License" : "GPL-3.0 许可证"; clicked => { root.legal-tab = 0; } }
                    Button { height: 30px; primary: root.legal-tab == 1; text: I18n.en ? "Third-party" : "第三方组件"; clicked => { root.legal-tab = 1; } }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { icon: @image-url("icons/close.svg"); label: I18n.en ? "Close" : "关闭"; clicked => { root.legal-open = false; } }
                }
                if root.legal-tab == 0: Rectangle {
                    vertical-stretch: 1; border-radius: Theme.radius-md; background: Palette.background; border-width: 1px; border-color: Theme.stroke;
                    VerticalLayout { padding: 6px;
                        ListView {
                            vertical-stretch: 1;
                            for line in root.license-lines: Rectangle {
                                height: 18px;
                                Text { x: 4px; width: parent.width - 8px; height: parent.height; text: line; font-family: "Consolas"; font-size: 11.5px; color: Palette.foreground; vertical-alignment: center; }
                            }
                        }
                    }
                }
                if root.legal-tab == 0: HorizontalLayout { alignment: end; spacing: 8px;
                    Button { height: 32px; text: I18n.en ? "Copy full text" : "复制全文"; clicked => { root.copy-license(); } }
                    Button { height: 32px; primary: true; text: I18n.en ? "Close" : "关闭"; clicked => { root.legal-open = false; } }
                }
                if root.legal-tab == 1: ListView {
                    vertical-stretch: 1;
                    for item in root.notice-items: Rectangle {
                        height: 64px;
                        Rectangle {
                            y: 2px; width: parent.width; height: 60px; border-radius: Theme.radius-md; background: Theme.navigation; border-width: 1px; border-color: Theme.stroke;
                            VerticalLayout { padding-left: 10px; padding-right: 10px; padding-top: 7px; padding-bottom: 7px; spacing: 4px; alignment: center;
                                HorizontalLayout { spacing: 8px;
                                    Text { text: item.name; font-weight: 600; font-size: 13px; color: Palette.foreground; vertical-alignment: center; }
                                    Text { text: item.version; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: item.license; font-size: 11px; color: Palette.accent-background; vertical-alignment: center; overflow: elide; }
                                }
                                Text { text: item.detail; font-size: 12px; color: Palette.alternate-foreground; overflow: elide; }
                            }
                            Tooltip { HintSurface { title: item.name + " " + item.version; detail: item.license; notes: item.detail; } }
                        }
                    }
                }
                if root.legal-tab == 1: Text {
                    text: I18n.en ? "All other transitive dependencies use permissive licenses compatible with GPL-3.0-only. The bundled Rust logo follows CC BY 4.0. App and web icons extracted at runtime stay in your local database and are not redistributed." : "其余传递依赖均采用与 GPL-3.0-only 兼容的宽松开源许可。内置 Rust 标志遵循 CC BY 4.0 协议，运行期提取的本机与网页图标仅保存在本地数据库中，不随软件分发。";
                    wrap: word-wrap; font-size: 11.5px; color: Theme.muted;
                }
                if root.legal-tab == 1: HorizontalLayout { alignment: end; spacing: 8px;
                    Button { height: 32px; primary: true; text: I18n.en ? "Close" : "关闭"; clicked => { root.legal-open = false; } }
                }
            }
        }
    }
}


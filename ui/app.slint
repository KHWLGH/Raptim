export { Palette } from "std-widgets.slint";
import { Button, LineEdit, ComboBox, CheckBox, Switch, Slider, SpinBox, ListView, ScrollView, Palette, AboutSlint } from "std-widgets.slint";
import { AppWindow, TitleBar, IconButton, Theme, SettingRow, HintSurface } from "chrome.slint";

export struct NavItem { id: int, name: string }
export struct ScopeNode { id: int, parent: int, label: string, depth: int, state: int }
export struct Item { checked: bool, id: int, name: string, detail: string, tooltip-path: string, tooltip-notes: string, kind: int, icon: image, drag-icon: image }
export struct DestinationNode { id: int, parent: int, name: string, expanded: bool }
export struct AppOption { name: string, aumid: string }

component PixelWidthInput inherits Rectangle {
    in-out property <int> value: 1;
    in property <bool> enabled: true;
    callback edited;
    property <bool> invalid;
    width: 44px; height: 32px; border-radius: 4px;
    background: Theme.surface; border-width: 1px;
    border-color: invalid ? #c42b1c : input.has-focus ? Palette.accent-background : Theme.stroke;
    forward-focus: input;
    accessible-role: text-input;
    accessible-label: "露边宽度（物理像素）";
    accessible-enabled: enabled;
    accessible-value <=> input.text;
    accessible-action-set-value(v) => { input.text = v; root.validate(); }
    changed value => { input.text = root.value; root.invalid = false; }
    changed enabled => { if !root.enabled { input.text = root.value; root.invalid = false; } }
    function validate() {
        root.invalid = !input.text.is-float() || input.text.to-float() < 1 || input.text.to-float() > 12 || floor(input.text.to-float()) != input.text.to-float();
        if !root.invalid { root.value = input.text.to-float(); root.edited(); }
    }
    input := TextInput {
        x: 4px; width: parent.width - 8px; height: parent.height;
        enabled: root.enabled; text: root.value; input-type: number; single-line: true;
        horizontal-alignment: center; vertical-alignment: center; color: Palette.foreground;
        edited => { root.validate(); }
        changed has-focus => { if !self.has-focus { self.text = root.value; root.invalid = false; } }
    }
    Tooltip { HintSurface { title: root.invalid ? "请输入 1–12 的整数" : "1–12 个物理像素"; } }
}

component Tile inherits Rectangle {
    in property <Item> item;
    in property <[NavItem]> destinations;
    in property <bool> selected;
    in property <bool> sortable;
    in property <bool> double-click;
    in property <bool> list-mode;
    in property <length> icon-size: 36px;
    in property <bool> search-result;
    in property <bool> batch-mode;
    callback action(int);
    callback launch;
    callback select;
    callback edit;
    callback open-menu;
    callback change-icon;
    callback convert-path(bool);
    callback remove;
    callback move(int);
    callback move-to(int);
    pure callback make-drag() -> data-transfer;
    callback can-drop(data-transfer) -> bool;
    callback drop-before(data-transfer, bool) -> bool;
    property <bool> insert-after;
    border-radius: 8px;
    opacity: tile-drag.dragging ? 0.4 : 1;
    background: (root.batch-mode && item.checked) || (root.search-result && selected) ? Theme.selection : touch.has-hover ? Theme.navigation : transparent;
    border-width: 0px;
    border-color: Palette.accent-background;
    accessible-role: button;
    accessible-label: root.batch-mode ? (item.checked ? "已选 " : "未选 ") + item.name : item.name;
    accessible-action-default => { root.launch(); }
    forward-focus: key;
    drop := DropArea {
        enabled: root.sortable;
        can-drop(event) => { root.insert-after = root.list-mode ? event.position.y > self.height / 2 : event.position.x > self.width / 2; return root.can-drop(event.data) ? DragAction.move : DragAction.none; }
        dropped(event) => { return root.drop-before(event.data,root.list-mode ? event.position.y > self.height / 2 : event.position.x > self.width / 2) ? DragAction.move : DragAction.none; }
        tile-drag := DragArea {
            enabled: !root.search-result && root.sortable;
            drag-image: root.item.drag-icon.width > 0 ? root.item.drag-icon : @image-url("icons/program.svg"); drag-image-offset-x: 18; drag-image-offset-y: 18;
            allow-move: true;
            data: root.make-drag();
            Rectangle {

                if !root.list-mode: VerticalLayout {
                    padding: 6px; spacing: 4px; alignment: center;
                    HorizontalLayout { alignment: center;
                        Rectangle { width: root.icon-size; height: root.icon-size; border-radius: 8px;
                            property <color> tint: item.kind == 2 ? #b68422 : item.kind == 3 ? #278879 : item.kind == 5 ? #8065b9 : Palette.accent-background;
                            background: item.icon.width > 0 ? transparent : Theme.surface.mix(self.tint, 0.87);
                            Image { x: item.icon.width > 0 ? 0px : 6px; y: self.x; width: item.icon.width > 0 ? root.icon-size : root.icon-size - 12px; height: self.width;
                                source: item.icon.width > 0 ? item.icon : item.kind == 2 ? @image-url("icons/folder.svg") : item.kind == 3 ? @image-url("icons/web.svg") : item.kind == 1 ? @image-url("icons/file.svg") : item.kind == 5 ? @image-url("icons/app.svg") : @image-url("icons/program.svg"); colorize: item.icon.width > 0 ? #0000 : parent.tint;
                            }
                        }
                    }
                    Text { text: item.name; color: Palette.foreground; font-size: 12px; horizontal-alignment: center; vertical-alignment: top; wrap: word-wrap; overflow: elide; height: 34px; }
                }
                if root.list-mode: HorizontalLayout {
                    padding: 12px; spacing: 12px;
                    Image { width: 28px; height: 28px; source: item.icon.width > 0 ? item.icon : @image-url("icons/program.svg"); colorize: item.icon.width > 0 ? #0000 : Palette.accent-background; }
                    VerticalLayout { spacing: 3px;
                        Text { text: item.name; color: Palette.foreground; overflow: elide; }
                        Text { text: item.detail; color: Palette.alternate-foreground; font-size: 12px; overflow: elide; }
                    }
                }
                key := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Return { root.launch(); return accept; }
                        if !root.batch-mode && event.text == Key.F2 { root.edit(); return accept; }
                        return reject;
                    }
                }
                touch := TouchArea {
                    Tooltip { HintSurface { title: root.item.name; detail: root.item.tooltip-path; notes: root.item.tooltip-notes; } }
                    clicked => { key.focus(); root.select(); if root.batch-mode || !root.double-click { root.launch(); } }
                    double-clicked => { if !root.batch-mode && root.double-click { root.launch(); } }
                    pointer-event(event) => {
                        if !root.batch-mode && event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                            key.focus(); root.select(); root.open-menu();
                        }
                    }
                }
            }
        }
    }

    if root.batch-mode: Rectangle { x: 4px; y: 4px; width: 16px; height: 16px; accessible-role: checkbox; accessible-label: root.item.name; accessible-checked: root.item.checked; accessible-action-default => { root.launch(); } border-radius: 3px; border-width: 1px; border-color: Palette.accent-background; background: root.item.checked ? Palette.accent-background : Theme.surface;
        Text { text: root.item.checked ? "✓" : ""; color: Palette.accent-foreground; horizontal-alignment: center; vertical-alignment: center; }
    }
    if drop.has-drag: Rectangle { x: root.list-mode ? 6px : root.insert-after ? parent.width - 2px : 0px; y: root.list-mode ? (root.insert-after ? parent.height - 2px : 0px) : 6px; height: root.list-mode ? 2px : parent.height - 12px; width: root.list-mode ? parent.width - 12px : 2px; border-radius: 1px; background: Palette.accent-background; }
}

component NavNode inherits Rectangle {
    in property <NavItem> node;
    in property <length> external-x: -1px;
    in property <length> external-y: -1px;
    in property <bool> external-drag;
    callback external-hit(int);
    property <bool> external-inside: external-drag && external-x >= self.absolute-position.x && external-x < self.absolute-position.x + self.width && external-y >= self.absolute-position.y && external-y < self.absolute-position.y + self.height;
    changed external-inside => { root.external-hit(self.external-inside ? root.node.id : -root.node.id); }

    in property <bool> active;
    in property <bool> group;
    in property <[NavItem]> groups;
    in property <bool> renaming;
    in-out property <string> rename-text;
    in property <bool> hover-switch;
    in property <int> hover-delay;
    callback select;
    callback open-menu;
    callback action(int, int);
    callback commit-name;
    callback cancel-name;
    pure callback drag-data() -> data-transfer;
    callback can-drop(data-transfer) -> bool;
    callback drop-data(data-transfer, bool) -> bool;
    property <bool> insert-after;
    preferred-width: max(72px, nav-label.preferred-width + 24px);
    preferred-height: max(38px, nav-label.preferred-height + 16px);
    border-radius: 6px;
    background: active || external-inside ? Theme.selection : hit.has-hover ? Theme.surface : transparent;
    accessible-role: button; accessible-label: node.name; accessible-action-default => { root.select(); }
    forward-focus: nav-focus;
    if active: Rectangle { x: root.group ? 12px : 0px; y: root.group ? parent.height - 3px : 10px; width: root.group ? parent.width - 24px : 3px; height: root.group ? 3px : 18px; border-radius: 2px; background: Palette.accent-background; }
    DropArea {
        can-drop(event) => { root.insert-after = root.group ? event.position.x > self.width / 2 : event.position.y > self.height / 2; return root.can-drop(event.data) ? DragAction.move : DragAction.none; }
        dropped(event) => { return root.drop-data(event.data,root.insert-after) ? DragAction.move : DragAction.none; }
        Timer { running: parent.has-drag; interval: 350ms; triggered => { root.select(); } }
        if self.has-drag: Rectangle { x: root.group && root.insert-after ? parent.width - 2px : 0px; y: !root.group && root.insert-after ? parent.height - 2px : 0px; width: root.group ? 2px : parent.width; height: root.group ? parent.height : 2px; background: Palette.accent-background; }
        DragArea { enabled: root.node.id > 0 && !root.renaming; allow-move: true; data: root.drag-data();
            Rectangle {

                nav-label := Text { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; text: root.node.name; color: root.active ? Palette.accent-background : Palette.foreground; horizontal-alignment: root.group ? center : left; vertical-alignment: center; wrap: root.group ? no-wrap : word-wrap; }
                nav-focus := FocusScope { key-pressed(event) => { if event.text == Key.Return { root.select(); return accept; } if event.text == Key.F2 && root.node.id > 0 { root.action(2, 0); return accept; } return reject; } }
                hit := TouchArea { clicked => { nav-focus.focus(); root.select(); } pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.up { root.open-menu(); } } }
                Timer { running: root.hover-switch && hit.has-hover && !root.active; interval: root.hover-delay * 1ms; triggered => { root.select(); } }
                Tooltip { HintSurface { title: root.node.name; } }
            }
        }
    }

}

/// Expandable group / category tree shared by the batch organizer and the project editor, so the
/// two cannot drift apart in indentation, focus ring or keyboard behaviour.
component NavTree inherits Rectangle {
    in property <[DestinationNode]> nodes;
    in property <int> selected;
    in property <int> cursor;
    callback pick(int);
    callback key(int);
    public function focus-tree() { tree-focus.focus(); }
    tree-focus := FocusScope {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.DownArrow { root.key(1); return accept; }
            if event.text == Key.UpArrow { root.key(-1); return accept; }
            if event.text == Key.RightArrow { root.key(2); return accept; }
            if event.text == Key.LeftArrow { root.key(-2); return accept; }
            if event.text == Key.Return { root.key(0); return accept; }
            return reject;
        }
        ScrollView {
            content-width: self.visible-width;
            content-y: -max(0px, min(root.cursor * 36px - self.visible-height + 36px, max(0px, self.content-height - self.visible-height)));
            VerticalLayout { spacing: 0px;
                for node[index] in root.nodes: Rectangle {
                    height: 36px; border-radius: 4px;
                    background: root.selected == node.id ? Theme.selection : row-hit.has-hover ? Theme.navigation : transparent;
                    border-width: root.cursor == index && tree-focus.has-focus ? 1px : 0px; border-color: Theme.stroke;
                    accessible-role: button; accessible-label: node.name; accessible-action-default => { root.pick(node.id); }
                    Image { x: node.parent == 0 ? 4px : 24px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: node.parent == 0 ? (node.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg")) : @image-url("icons/folder.svg"); colorize: Palette.foreground; }
                    Text { x: node.parent == 0 ? 26px : 46px; width: parent.width - self.x - 6px; height: parent.height; text: node.name; vertical-alignment: center; overflow: elide; color: Palette.foreground; }
                    row-hit := TouchArea { clicked => { tree-focus.focus(); root.pick(node.id); } }
                    Tooltip { HintSurface { title: node.name; } }
                }
            }
        }
    }
}

export component MainWindow inherits AppWindow {
    in-out property <bool> window-active <=> root.frame-active;
    title: "Diascia";
    preferred-width: 440px; preferred-height: 640px;
    min-width: 400px; min-height: 450px;
    in property <[NavItem]> groups;
    in property <[NavItem]> destinations;
    in property <[NavItem]> categories;
    in property <bool> double-click;
    in property <int> icon-size: 1;
    in property <bool> list-view;
    callback view-change(int);
    in property <bool> hover-switch;
    in property <int> hover-delay: 350;
    callback pin-changed;
    callback drag-start;
    callback change-icon(int);
    callback convert-path(int, bool);
    in property <[Item]> items;
    in-out property <length> grid-scroll <=> content.content-y;
    in-out property <int> search-scope;
    callback search-scope-changed;
    in-out property <bool> batch-mode;
    in property <int> batch-count;
    in-out property <bool> batch-confirm;
    in-out property <int> batch-destination;
    in property <bool> batch-all-selected;
    in-out property <bool> batch-target-open;
    in property <int> batch-action;
    in property <[DestinationNode]> batch-nodes;
    in property <string> batch-target-name;
    in-out property <string> batch-error;
    in property <int> batch-tree-index;
    callback batch-target(int);
    callback batch-node(int);
    callback batch-tree-key(int);
    public function focus-batch-tree() { batch-tree.focus-tree(); }
    callback batch-start(int);
    callback batch-all;
    callback batch-cancel;
    callback batch-execute(int, int);
    callback viewport-changed;
    callback interaction-changed;
    changed interacting => { root.interaction-changed(); }
    changed search-open => { root.interaction-changed(); }
    out property <int> grid-first: max(0, floor(-content.content-y / content.row-height) - 1) * content.columns;
    out property <int> grid-visible-count: (ceil(content.visible-height / content.row-height) + 3) * content.columns;
    out property <int> search-first: max(0, floor(-search-results.content-y / 64px) - 1);
    out property <int> search-visible-count: ceil(search-results.visible-height / 64px) + 3;
    changed grid-first => { root.viewport-changed(); }
    changed grid-visible-count => { root.viewport-changed(); }
    changed search-first => { root.viewport-changed(); }

    in property <int> group-id;
    in property <int> category-id;
    in-out property <int> selected-id;
    in-out property <string> query;
    in-out property <string> status;
    in-out property <bool> confirm-delete;
    in-out property <bool> pinned;
    in-out property <bool> drop-hover;
    in-out property <length> external-x: -1px;
    in-out property <length> external-y: -1px;
    in-out property <int> external-category;
    callback external-drop(string);

    in property <bool> busy;
    out property <bool> search-focused: search-input.has-focus;
    callback search(string);
    callback choose-group(int);
    callback choose-category(int);
    callback launch(int);
    callback edit(int);
    callback native-menu(int, int);
    callback copy-to(int, int);
    callback refresh-icon-ready(string);
    callback add;
    callback add-files;
    callback move(int, int);
    callback move-to(int, int);
    callback remove(int);
    callback manage-group(int);
    callback collection-action(int, int, int);
    callback item-action(int, int);
    callback global-action(int);
    callback scope-toggle(int, bool);
    callback scope-all(bool);
    callback apply-conversion;
    callback begin-conversion(bool);
    callback commit-name;
    callback cancel-name;
    callback finish-delete(int);
    pure callback nav-drag(int) -> data-transfer;
    callback nav-can-drop(data-transfer, int) -> bool;
    callback nav-drop(data-transfer, int, bool) -> bool;
    in property <[Item]> results;
    in property <[ScopeNode]> scopes;
    in property <bool> scope-selected;
    in property <[NavItem]> delete-destinations;
    in property <[string]> delete-names;
    in-out property <int> delete-target;
    in-out property <bool> collection-delete;
    in-out property <bool> conversion-open;
    in-out property <bool> conversion-relative;
    in property <string> conversion-summary;
    in property <string> conversion-details;
    in-out property <bool> search-open;
    in-out property <int> saved-selection;
    in-out property <int> inline-kind;
    in-out property <int> inline-id;
    in-out property <string> inline-text;
    in-out property <string> inline-error;
    in-out property <string> inline-context;
    in-out property <string> delete-name;
    in-out property <bool> delete-has-content;
    in-out property <bool> delete-is-group;
    in-out property <bool> delete-discard;
    in-out property <bool> more-open;
    in-out property <bool> relocate-open;
    /// Set from the winit event filter, which runs before Slint sees the key. The guard below is
    /// the layer an offscreen test can prove; the filter is the layer that fixes real delivery.
    in property <bool> composing;
    in property <string> relocate-name;
    in property <string> relocate-target;
    in property <string> relocate-message;
    public function show-more() { root.native-menu(0,0); }

    out property <bool> interacting: root.batch-mode || root.more-open || root.search-open || root.conversion-open || root.collection-delete || root.confirm-delete || root.relocate-open;
    changed status => { status-timer.restart(); }
    status-timer := Timer { interval: 6000ms; triggered => { root.status = ""; } }
    public function dismiss-search() { root.search-open = false; root.query = ""; root.search(""); root.restore-grid-focus(); }
    public function reveal-result(index: int) {
        if index * 64px < -search-results.content-y { search-results.content-y = -index * 64px; }
        else if (index + 1) * 64px > -search-results.content-y + search-results.height { search-results.content-y = search-results.height - (index+1)*64px; }
    }
    public function restore-grid-focus() { root.selected-id = root.saved-selection; grid-focus.focus(); }
    public function focus-browser() { if root.search-open { search-input.focus(); } else { grid-focus.focus(); } }
    callback settings;
    callback quit;
    callback request-hide;
    callback escape;
    callback native-event(int, string);
    callback launch-finished(string);
    callback relocate;
    callback file-selected(int, string);
    callback files-ready(string);
    callback icon-ready(string);
    callback icons-ready(string);
    pure callback make-drag(int) -> data-transfer;
    callback can-drop(data-transfer) -> bool;
    callback drop-before(data-transfer, int, bool) -> bool;
    public function focus-search() { if !root.search-open { root.saved-selection = root.selected-id; } root.search-open = true; search-input.focus(); }
    public function clear-search() { root.query = ""; root.search(""); search-input.focus(); }
    public function submit-search() { if root.results.length > 0 { root.launch(root.selected-id != 0 ? root.selected-id : root.results[0].id); } }
    public function close-popups() { root.more-open = false; grid-focus.focus(); }
    public function focus-inline-name() { inline-name.focus(); inline-name.select-all(); }
    grid-focus := FocusScope { key-pressed(event) => {
        if root.batch-target-open || root.batch-confirm { return reject; }
        if root.batch-mode && !root.search-focused && !root.batch-target-open && !root.batch-confirm && event.modifiers.control && event.text.to-lowercase() == "a" { if !root.batch-all-selected { root.batch-all(); } return accept; }
        if !root.batch-mode && root.selected-id != 0 && event.text == Key.F2 { root.edit(root.selected-id); return accept; }
        if root.selected-id != 0 && event.text == Key.Return { root.launch(root.selected-id); return accept; }
        return reject;
    } }
    VerticalLayout {
        padding: 1px; padding-bottom: root.batch-mode ? 88px : 1px; spacing: 0px;
        Rectangle { height: 44px;
            TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag-start(); } } }
            HorizontalLayout { padding-left: 10px; padding-right: 6px; padding-top: 6px; padding-bottom: 6px; spacing: 2px;
            if !root.search-open: IconButton { icon: @image-url("icons/search.svg"); label: "搜索 · Ctrl+F"; clicked => { root.focus-search(); } }
            Rectangle { visible: root.search-open; horizontal-stretch: 1; min-width: root.search-open ? 230px : 0px;
                HorizontalLayout { spacing: 4px;
                    ComboBox { width: 108px; model: ["全部", "当前分组", "当前分类"]; current-index <=> root.search-scope; accessible-label: "搜索范围"; selected => { root.search-scope-changed(); } }
                    search-input := LineEdit { min-width: 72px; text <=> root.query; placeholder-text: "搜索项目"; accessible-label: "搜索已收录项目"; edited(value) => { root.search(value); } accepted => { if !root.composing { root.submit-search(); } } }
                    IconButton { icon: @image-url("icons/close.svg"); label: root.query == "" ? "关闭搜索" : "清空搜索"; clicked => { if root.query == "" { root.dismiss-search(); } else { root.clear-search(); } } }
                }
            }
            if !root.search-open: Rectangle { horizontal-stretch: 1; }
            if !root.search-open: Rectangle { width: 32px;
            IconButton { icon: @image-url("icons/add.svg"); label: "添加项目"; clicked => { root.add(); } }
            }
            if !root.search-open: Rectangle { width: 32px;
            IconButton { icon: @image-url("icons/pin.svg"); label: root.pinned ? "取消固定" : "临时固定"; checked: root.pinned; clicked => { root.pinned = !root.pinned; root.pin-changed(); } }
            }
            IconButton { icon: @image-url("icons/more.svg"); label: "更多"; checked: root.more-open; clicked => { root.show-more(); } }
            IconButton { icon: @image-url("icons/close.svg"); label: "关闭"; danger: true; clicked => { root.request-hide(); } }
            }
        }
        // Groups share the title surface; categories occupy the vertical rail.
        Rectangle { height: 46px; background: Theme.canvas;
            HorizontalLayout { padding-left: 10px; padding-right: 8px; padding-bottom: 6px; spacing: 4px;
                group-tabs := ScrollView {
                    content-width: max(self.visible-width, group-row.preferred-width);
                    content-height: 36px;
                    group-row := HorizontalLayout { spacing: 4px; alignment: start;
                    for group[index] in root.groups: NavNode {
                        horizontal-stretch: 0; height: 36px;
                        node: group; group: true; groups: root.groups; active: root.group-id == group.id;
                        changed active => { if self.active { group-tabs.content-x = min(0px, max(group-tabs.visible-width - group-tabs.content-width, -self.x)); } }
                        hover-switch: root.hover-switch && !root.interacting; hover-delay: root.hover-delay;
                        renaming: root.inline-kind == 1 && root.inline-id == group.id; rename-text <=> root.inline-text;
                        select => { root.choose-group(group.id); }
                        action(kind,target) => { root.collection-action(group.id,kind,target); }
                        commit-name => { root.commit-name(); } cancel-name => { root.cancel-name(); }
                        drag-data => { return root.nav-drag(group.id); }
                        can-drop(data) => { return root.nav-can-drop(data,group.id); }
                        drop-data(data,after) => { return root.nav-drop(data,group.id,after); }
                        open-menu => { root.native-menu(2,group.id); }
                    }
                    }
                }
                IconButton { icon: @image-url("icons/add.svg"); label: "新建分组"; clicked => { root.collection-action(0,0,0); } }
            }
        }
        Rectangle { height: 1px; background: Theme.stroke; }
        HorizontalLayout { spacing: 0px;
            Rectangle { width: 92px; background: Theme.navigation;
                VerticalLayout { padding: 6px; spacing: 4px;
                    category-scroll := ScrollView { content-width: self.visible-width;
                        // Flickable does not compute content-height for `for` loops, so bind it
                        // explicitly: this is the scroll range of the rail.
                        content-height: category-list.preferred-height;
                        category-list := VerticalLayout { spacing: 4px; alignment: start;
                            for category in root.categories: NavNode {
                                external-x: root.external-x; external-y: root.external-y; external-drag: root.drop-hover && root.external-y >= category-scroll.absolute-position.y && root.external-y < category-scroll.absolute-position.y + category-scroll.height;
                                external-hit(id) => { if id > 0 { root.external-category = id; } else if root.external-category == -id { root.external-category = 0; } }
                                node: category; groups: root.groups; active: root.category-id == category.id;
                                hover-switch: root.hover-switch && !root.interacting; hover-delay: root.hover-delay;
                                renaming: root.inline-kind == 1 && root.inline-id == category.id; rename-text <=> root.inline-text;
                                select => { root.choose-category(category.id); }
                                action(kind,target) => { root.collection-action(category.id,kind,target); }
                                commit-name => { root.commit-name(); } cancel-name => { root.cancel-name(); }
                                drag-data => { return root.nav-drag(category.id); }
                                can-drop(data) => { return root.nav-can-drop(data,category.id); }
                                drop-data(data,after) => { return root.nav-drop(data,category.id,after); }
                                open-menu => { root.native-menu(3,category.id); }
                            }
                        }
                    }
                    IconButton { icon: @image-url("icons/add.svg"); label: "新建子分类"; clicked => { root.collection-action(0,1,0); } }
                }
            }
            Rectangle { background: Theme.surface;
                VerticalLayout { padding: 12px; spacing: 8px;
                    if root.inline-kind > 0 && root.inline-kind < 3 && root.inline-error != "": Text { text: root.inline-error; wrap: word-wrap; color: Palette.foreground; }
                    Rectangle {
                        TouchArea { pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.up { root.native-menu(4,root.category-id); } } }
                        content := ListView {
                            content-width: self.visible-width;
                            property <int> columns: root.list-view ? 1 : max(2, min(root.icon-size == 0 ? 5 : root.icon-size == 2 ? 3 : 4, floor(self.visible-width / (root.icon-size == 0 ? 58px : root.icon-size == 2 ? 92px : 72px))));
                            property <length> row-height: root.list-view ? 64px : root.icon-size == 0 ? 88px : root.icon-size == 2 ? 118px : 104px;
                            for row in ceil(root.items.length / content.columns): Rectangle {
                            height: content.row-height;
                            for col in content.columns: Tile {
                                property <int> item-index: row * content.columns + col;
                                property <Item> entry: root.items[self.item-index];
                                visible: self.item-index < root.items.length;
                                item: self.entry; batch-mode: root.batch-mode; list-mode: root.list-view; icon-size: root.icon-size == 0 ? 28px : root.icon-size == 2 ? 48px : 36px; double-click: root.double-click; destinations: root.destinations;
                                selected: root.selected-id == self.entry.id; sortable: !root.busy && !root.batch-mode && root.inline-kind == 0;
                                x: col * (content.visible-width / content.columns);
                                y: 0px;
                                width: content.visible-width / content.columns; height: content.row-height - 6px;
                                launch => { if !root.busy { root.launch(self.entry.id); } }
                                select => { root.selected-id = self.entry.id; }
                                edit => { root.edit(self.entry.id); } open-menu => { root.native-menu(1,self.entry.id); }
                                action(kind) => { root.item-action(self.entry.id,kind); }
                                change-icon => { root.change-icon(self.entry.id); } convert-path(relative) => { root.convert-path(self.entry.id,relative); }
                                remove => { root.selected-id = self.entry.id; root.delete-name = self.entry.name; root.inline-error = ""; root.confirm-delete = true; }
                                move(direction) => { root.move(self.entry.id,direction); } move-to(destination) => { root.move-to(self.entry.id,destination); }
                                make-drag => { return root.make-drag(self.entry.id); }
                                can-drop(data) => { return root.can-drop(data); } drop-before(data,after) => { return root.drop-before(data,self.entry.id,after); }
                            }
                            }
                        }
                            if root.items.length == 0: VerticalLayout { width: parent.width; height: 200px; alignment: center; spacing: 16px;
                                Text { text: "还没有项目"; color: Palette.alternate-foreground; horizontal-alignment: center; }
                                HorizontalLayout { alignment: center; Button { text: "添加项目"; clicked => { root.add(); } } }
                            }
                    }
                }
            }
        }
        if root.status != "": Rectangle { height: 36px; background: Theme.navigation;
            HorizontalLayout { padding-left: 12px; spacing: 8px;
                Text { text:root.status; color:Palette.alternate-foreground; font-size:12px; overflow:elide; vertical-alignment:center; }
                IconButton { icon: @image-url("icons/close.svg"); label: "关闭提示"; clicked => { root.status = ""; } }
            }
            Tooltip { HintSurface { title: root.status; } }
        }
    }
    // `visible:` rather than `if`, so `focus-inline-name` can reach the LineEdit id: an element
    // inside a conditional block is scoped to that block.
    Rectangle { visible: root.inline-kind != 0; background: #0002; TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 360px; height: 214px;
            background: Theme.surface; border-width: 1px; border-color: Theme.stroke; border-radius: 8px;
            VerticalLayout { padding: 20px; spacing: 12px;
                Text { text: root.inline-kind == 3 ? "新建分组" : root.inline-kind == 4 ? "新建子分类" : "修改名称"; font-weight: 600; color: Palette.foreground; }
                Text { text: "名称"; color: Palette.alternate-foreground; }
                inline-name := LineEdit { text <=> root.inline-text; accessible-label: "名称";
                    accepted => { if !root.composing { root.commit-name(); } } }
                if root.inline-error != "": Text { text: root.inline-error; color: #c42b1c; wrap: word-wrap; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: "取消"; clicked => { root.cancel-name(); } }
                    Button { text: "确定"; primary: true; enabled: root.inline-text != ""; clicked => { root.commit-name(); } }
                }
            }
        }
    }
    if root.drop-hover: Rectangle { background: #0078d422; border-width: 2px; border-color: Palette.accent-background; border-radius: 8px; }
    Rectangle { visible: root.search-open; y: 44px; height: parent.height - 44px; background: #0004;
        TouchArea { clicked => { root.dismiss-search(); } }
        Rectangle { x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - (root.batch-mode ? 104px : 20px); background: Theme.surface; border-width: 1px; border-color: Theme.stroke; border-radius: 6px;
            TouchArea { }
            VerticalLayout { padding: 12px; spacing: 10px;
                if root.results.length == 0: Text { text: root.query == "" ? "搜索全部已收录项目" : "没有匹配项目"; color: Palette.alternate-foreground; horizontal-alignment: center; }
                search-results := ListView {
                        for item in root.results: Tile { height: 64px; item: item; list-mode: true; search-result: true; batch-mode: root.batch-mode; destinations: root.destinations; double-click: root.double-click;
                            selected: root.selected-id == item.id;
                                launch => { if !root.busy { root.launch(item.id); } }
                                select => { root.selected-id = item.id; }
                                edit => { root.edit(item.id); } open-menu => { root.native-menu(1,item.id); }
                                action(kind) => { root.item-action(item.id,kind); }
                                change-icon => { root.change-icon(item.id); } convert-path(relative) => { root.convert-path(item.id,relative); }
                                remove => { root.selected-id = item.id; root.delete-name = item.name; root.inline-error = ""; root.confirm-delete = true; }
                                move(direction) => { root.move(item.id,direction); } move-to(destination) => { root.move-to(item.id,destination); }
                        }
                }

            }
        }
    }
    if root.batch-mode: Rectangle {
        x: 12px; y: parent.height - 88px; width: parent.width - 24px; height: 76px; background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.stroke;
        VerticalLayout { padding: 6px; spacing: 4px;
            // A layout grows every cell from its own content, so the two rows drifted apart by
            // however much the labels differ. One shared floor makes the three cells equal, which
            // puts 全选 and 完成 exactly above 复制到… and 删除.
            HorizontalLayout { spacing: 4px;
                Rectangle { horizontal-stretch: 1; min-width: 96px;
                    Text { x: 0px; width: parent.width; height: parent.height; text: "已选 " + root.batch-count; color: Palette.foreground; vertical-alignment: center; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; min-width: 96px;
                    Button { width: parent.width; height: parent.height; text: root.batch-all-selected ? "取消全选" : "全选"; clicked => { root.batch-all(); } }
                }
                Rectangle { horizontal-stretch: 1; min-width: 96px;
                    Button { width: parent.width; height: parent.height; text: "完成"; clicked => { root.batch-cancel(); } }
                }
            }
            HorizontalLayout { spacing: 4px;
                Rectangle { horizontal-stretch: 1; min-width: 96px;
                    Button { width: parent.width; height: parent.height; text: "移动到…"; enabled: root.batch-count > 0; clicked => { root.batch-target(0); } }
                }
                Rectangle { horizontal-stretch: 1; min-width: 96px;
                    Button { width: parent.width; height: parent.height; text: "复制到…"; enabled: root.batch-count > 0; clicked => { root.batch-target(1); } }
                }
                Rectangle { horizontal-stretch: 1; min-width: 96px;
                    Button { width: parent.width; height: parent.height; text: "删除"; enabled: root.batch-count > 0; clicked => { root.batch-error = ""; root.batch-confirm = true; } }
                }
            }
        }
    }
    Rectangle {
        visible: root.batch-target-open;
        background: #0005;
        TouchArea { }
        Rectangle {
            x: 16px; y: 52px; width: parent.width - 32px; height: parent.height - 76px;
            background: Theme.surface; border-width: 1px; border-color: Theme.stroke; border-radius: 8px;
            VerticalLayout { padding: 14px; spacing: 10px;
                Text { text: root.batch-action == 0 ? "移动到" : "复制到"; font-size: 16px; font-weight: 600; color: Palette.foreground; }
                batch-tree := NavTree {
                    nodes: root.batch-nodes; selected: root.batch-destination; cursor: root.batch-tree-index;
                    pick(id) => { root.batch-node(id); }
                    key(delta) => { root.batch-tree-key(delta); }
                }
                Text { text: root.batch-target-name; color: Palette.foreground; wrap: word-wrap; }
                if root.batch-error != "": Text { text: root.batch-error; color: #c42b1c; wrap: word-wrap; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: "取消"; clicked => { root.batch-target-open = false; root.focus-browser(); } }
                    Button { text: root.batch-action == 0 ? "移动" : "复制"; primary: true; enabled: root.batch-destination != 0; clicked => { root.batch-execute(root.batch-action,root.batch-destination); } }
                }
            }
        }
    }
    if root.batch-confirm: Rectangle { background: #0005; TouchArea { }
        Rectangle { x: 20px; y: (parent.height - self.height) / 2; width: parent.width - 40px; height: self.preferred-height; background: Theme.surface; border-radius: 8px;
            VerticalLayout { padding: 16px; spacing: 12px;
                Text { text: "删除选中的 " + root.batch-count + " 个项目？"; color: Palette.foreground; }
                Text { text: "只删除启动器记录，原文件保留。"; color: Palette.alternate-foreground; }
                if root.batch-error != "": Text { text: root.batch-error; color: #c42b1c; wrap: word-wrap; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: "取消"; clicked => { root.batch-confirm = false; root.focus-browser(); } }
                    Button { text: "删除"; primary: true; clicked => { root.batch-execute(2,0); } }
                }
            }
        }
    }
    if root.relocate-open: Rectangle { background: #0005; TouchArea { }
        Rectangle { x: 20px; y: (parent.height - self.height) / 2; width: parent.width - 40px; height: self.preferred-height; background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.stroke;
            VerticalLayout { padding: 16px; spacing: 12px;
                Text { text: "重新定位「" + root.relocate-name + "」"; color: Palette.foreground; wrap: word-wrap; }
                Text { text: root.relocate-target; color: Palette.alternate-foreground; wrap: word-wrap; font-size: 12px; }
                Text { text: root.relocate-message; color: Palette.alternate-foreground; wrap: word-wrap; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: "取消"; clicked => { root.relocate-open = false; root.focus-browser(); } }
                    Button { text: "选择新目标"; clicked => { root.relocate(); } }
                }
            }
        }
    }
    if root.conversion-open: Rectangle { background: #0005; TouchArea { }
        Rectangle { x: 12px; y: 52px; width: parent.width - 24px; height: parent.height - 72px; background: Theme.surface; border-radius: 10px; border-width: 1px; border-color: Theme.stroke;
            VerticalLayout { padding: 16px; spacing: 12px;
                Text { text: root.conversion-relative ? "转换为相对路径" : "转换为绝对路径"; font-size: 18px; font-weight: 600; color: Palette.foreground; }
                HorizontalLayout { alignment: start; Button { text: "全选"; clicked => { root.scope-all(true); } } Button { text: "清空"; clicked => { root.scope-all(false); } } }
                ScrollView { content-width: self.visible-width;
                    VerticalLayout { spacing: 4px; alignment: start;
                        for node in root.scopes: HorizontalLayout { height: 32px; padding-left: node.depth * 20px;
                            Rectangle { horizontal-stretch: 1; height: 32px;
                                accessible-role: checkbox; accessible-label: node.label; accessible-checked: node.state == 2;
                                accessible-action-default => { root.scope-toggle(node.id,node.state != 2); }
                                Rectangle { x:0px; y:7px; width:18px; height:18px; border-radius:4px; border-width:1px; border-color: node.state == 0 ? Theme.stroke : Palette.accent-background; background: node.state == 0 ? Theme.surface : Palette.accent-background;
                                    if node.state != 0: Text { text: node.state == 1 ? "−" : "✓"; color: Palette.accent-foreground; horizontal-alignment:center; vertical-alignment:center; }
                                }
                                Text { x:28px; width:parent.width - 28px; text:node.label; color:Palette.foreground; vertical-alignment:center; overflow:elide; }
                                FocusScope { key-pressed(event) => { if event.text == " " { root.scope-toggle(node.id,node.state != 2); return accept; } return reject; } }
                                TouchArea { clicked => { root.scope-toggle(node.id,node.state != 2); } }
                            }
                        }
                    }
                }
                Text { text: root.conversion-summary; wrap: word-wrap; color: Palette.foreground; }
                if root.conversion-details != "": ScrollView { height: 70px; content-width: self.visible-width; Text { text: root.conversion-details; wrap: word-wrap; color: Palette.alternate-foreground; font-size: 12px; } }
                HorizontalLayout { alignment: end; Button { text: "关闭"; clicked => { root.conversion-open = false; } } Button { text: "转换"; primary: true; enabled: root.scope-selected && !root.busy; clicked => { root.apply-conversion(); } } }
            }
        }
    }
    if root.collection-delete || root.confirm-delete: Rectangle { background: #0005; TouchArea { }
        Rectangle { width: parent.width - 32px; height: delete-form.preferred-height; x: 16px; y: (parent.height - self.height) / 2; border-radius: 8px; border-width: 1px; border-color: Theme.stroke; background: Theme.surface;
            FocusScope { init => { self.focus(); } key-pressed(event) => { if event.text == Key.Escape { root.confirm-delete = false; root.collection-delete = false; return accept; } return reject; } }
            delete-form := VerticalLayout { padding: 20px; spacing: 14px;
                Text { text: root.collection-delete ? (root.delete-is-group ? "删除分组？" : "删除分类？") : "删除项目？"; font-size: 18px; font-weight: 600; color: Palette.foreground; }
                Text { text: root.delete-name; color: Palette.foreground; overflow: elide; font-weight: 600; }
                Text { text: root.collection-delete ? (root.delete-has-content ? (root.delete-discard ? "项目和子分类将一并从 Diascia 移除，原文件不会被删除。" : "将内容迁移到下列位置，然后删除。") : "此位置没有内容，可以直接删除。") : "仅从 Diascia 移除，原文件不会被删除。"; wrap: word-wrap; color: Palette.alternate-foreground; }
                if root.collection-delete && root.delete-has-content && !root.delete-discard: ComboBox { model: root.delete-names; current-index <=> root.delete-target; accessible-label: "内容迁移到"; }
                if root.collection-delete && root.delete-has-content: CheckBox { text: "不迁移，直接删除其中的项目和子分类"; checked <=> root.delete-discard; }
                if root.inline-error != "": Text { text: root.inline-error; wrap: word-wrap; color: #c42b1c; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: "取消"; clicked => { root.confirm-delete = false; root.collection-delete = false; } }
                    Button { text: root.collection-delete && root.delete-has-content && !root.delete-discard ? "迁移并删除" : "删除"; primary: true; clicked => { if root.collection-delete { root.finish-delete(root.delete-target); } else { root.remove(root.selected-id); root.confirm-delete = false; } } }
                }
            }
        }
    }

}

export component EditorWindow inherits AppWindow {
    in-out property <bool> window-active <=> root.frame-active;
    in property <bool> editing;
    title: root.editing ? "编辑项目" : "添加项目";
    preferred-width: 520px; preferred-height: 650px;
    min-width: 460px; min-height: 480px;
    in-out property <string> entry-name;
    in-out property <string> target;
    in-out property <string> aliases;
    in-out property <string> notes;
    in-out property <string> arguments;
    in-out property <string> working-dir;
    in-out property <bool> elevated;
    in-out property <int> show-mode;
    in-out property <int> kind;
    in-out property <int> collection-id;
    in property <string> collection-name;
    in property <[DestinationNode]> collection-nodes;
    in-out property <bool> collection-open;
    in-out property <int> collection-cursor;
    callback pick-collection;
    callback collection-node(int);
    callback collection-key(int);
    /// The installed-app list is an overlay on this form rather than a window of its own: it is
    /// only ever opened from here, and a separate top-level would keep its own backing surface
    /// alive for the rest of the session.
    in-out property <bool> picker-open;
    in property <[AppOption]> picker-shown;
    in-out property <string> picker-filter;
    in-out property <string> picker-aumid;
    in-out property <string> picker-name;
    callback picker-refilter;
    callback picker-confirm(string, string);
    in-out property <string> error;

    in-out property <bool> discard-confirm;
    in property <image> entry-icon;
    in property <bool> saving;
    callback icon-path(string); callback pick-app;
    callback browse-icon; callback reset-icon; callback convert-path(bool);
    callback save; callback cancel; callback discard; callback keep-editing; callback browse;
    public function focus-name() { name-input.focus(); name-input.select-all(); }
    public function focus-picker-filter() { picker-filter-input.focus(); picker-filter-input.select-all(); }
    VerticalLayout {
        spacing: 0px;
        TitleBar { title: root.editing ? "编辑项目" : "添加项目"; close => { root.cancel(); } }
        Rectangle { background: Theme.surface;
            VerticalLayout { padding: 20px; spacing: 12px;
                ScrollView { content-width: self.visible-width;
                    VerticalLayout { padding-right: 8px; spacing: 10px; alignment: start;
                        HorizontalLayout { spacing: 12px;
                            Text { width: 64px; text: "名称"; color: Palette.foreground; vertical-alignment: center; }
                            name-input := LineEdit { enabled: !root.saving; text <=> root.entry-name; placeholder-text: "项目名称"; accessible-label: "名称"; }
                        }
                        HorizontalLayout { spacing: 12px; alignment: start;
                            Text { width: 64px; text: "图标"; color: Palette.foreground; vertical-alignment: center; }
                            Image { width: 40px; height: 40px; source: root.entry-icon.width > 0 ? root.entry-icon : @image-url("icons/file.svg"); }
                            Button { text: "选择图标"; clicked => { root.browse-icon(); } }
                            Button { text: root.kind == 3 ? "提取网页图标" : root.kind == 5 ? "提取应用图标" : "从目标提取"; clicked => { root.reset-icon(); } }
                        }
                        HorizontalLayout { spacing: 12px;
                            VerticalLayout { width: 132px; spacing: 6px;
                                Text { text: "类型"; color: Palette.alternate-foreground; font-size: 12px; }
                                ComboBox { min-width: 0px; model: ["程序", "文件", "文件夹", "网址", "快捷方式", "应用 AUMID"]; current-index <=> root.kind; accessible-label: "目标类型"; }
                            }
                            VerticalLayout { spacing: 6px;
                                Text { text: "所属分类"; color: Palette.alternate-foreground; font-size: 12px; }
                                Button { text: root.collection-name; enabled: !root.collection-open; clicked => { root.pick-collection(); } }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.stroke; }
                        HorizontalLayout { spacing: 12px;
                            Text { width: 64px; text: root.kind == 5 ? "应用标识" : root.kind == 3 ? "网址" : "目标路径"; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { text <=> root.target; enabled: root.kind != 5; accessible-label: "目标"; placeholder-text: root.kind == 3 ? "https://example.com 或 example.com" : root.kind == 5 ? "从下方应用列表选择" : "选择或输入目标"; }
                            if root.kind == 5: IconButton { icon: @image-url("icons/app.svg"); label: "从应用列表选择"; clicked => { root.pick-app(); } }
                            if root.kind != 3 && root.kind != 5: IconButton { icon: @image-url("icons/folder.svg"); label: "选择目标"; clicked => { root.browse(); } }
                        }
                        if root.kind != 3 && root.kind != 5: HorizontalLayout { padding-left: 76px; alignment: start; spacing: 8px;
                            Button { text: "转为相对路径"; clicked => { root.convert-path(true); } }
                            Button { text: "转为绝对路径"; clicked => { root.convert-path(false); } }
                        }
                        if root.kind == 0: HorizontalLayout { spacing: 12px;
                            Text { width: 64px; text: "参数"; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { text <=> root.arguments; accessible-label: "参数"; }
                        }
                        if root.kind == 0: HorizontalLayout { spacing: 12px;
                            Text { width: 64px; text: "工作目录"; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { text <=> root.working-dir; accessible-label: "工作目录"; }
                        }
                        if root.kind == 0: HorizontalLayout { padding-left: 76px; alignment: start;
                            CheckBox { text: "以管理员身份运行"; checked <=> root.elevated; }
                        }
                        if root.kind == 0 || root.kind == 4: HorizontalLayout { spacing: 12px;
                            Text { width: 64px; text: "打开方式"; color: Palette.foreground; vertical-alignment: center; }
                            ComboBox { model: ["普通", "最大化", "最小化"]; current-index <=> root.show-mode; }
                        }
                        Rectangle { height: 1px; background: Theme.stroke; }
                        HorizontalLayout { spacing: 12px;
                            Text { width: 64px; text: "别名"; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { text <=> root.aliases; accessible-label: "别名"; placeholder-text: "用于搜索"; }
                        }
                        HorizontalLayout { spacing: 12px;
                            Text { width: 64px; text: "备注"; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { text <=> root.notes; accessible-label: "备注"; }
                        }
                    }
                }
                if root.error != "": Text { text: root.error; color: Palette.foreground; wrap: word-wrap; }
            }
        }
        Rectangle { height: 1px; background: Theme.stroke; }
        HorizontalLayout { padding: 16px; spacing: 8px; alignment: end;
            Button { text: "取消"; clicked => { root.cancel(); } }
            Button { text: root.saving ? "正在保存…" : root.editing ? "保存" : "添加"; enabled: !root.saving; primary: true; clicked => { root.save(); } }
        }
    }
    if root.discard-confirm: Rectangle { background: #0005; TouchArea { }
        Rectangle { x: 24px; width: parent.width - 48px; height: discard-form.preferred-height; y: (parent.height - self.height) / 2; background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.stroke;
            discard-form := VerticalLayout { padding: 20px; spacing: 16px;
                Text { text: "放弃未保存的更改？"; font-size: 18px; font-weight: 600; color: Palette.foreground; }
                Text { text: "关闭后将丢失本次编辑的内容。"; color: Palette.alternate-foreground; wrap: word-wrap; }
                HorizontalLayout { spacing: 8px; alignment: end;
                    Button { text: "继续编辑"; clicked => { root.discard-confirm = false; root.keep-editing(); } }
                    Button { text: "放弃更改"; clicked => { root.discard(); } }
                }
            }
        }
    }
    if root.collection-open: Rectangle { background: #0005; TouchArea { }
        Rectangle { x: 24px; y: 48px; width: parent.width - 48px; height: parent.height - 96px; background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.stroke;
            VerticalLayout { padding: 14px; spacing: 10px;
                Text { text: "选择所属分类"; font-size: 16px; font-weight: 600; color: Palette.foreground; }
                collection-tree := NavTree {
                    nodes: root.collection-nodes; selected: root.collection-id; cursor: root.collection-cursor;
                    pick(id) => { root.collection-node(id); }
                    key(delta) => { root.collection-key(delta); }
                }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: "取消"; clicked => { root.collection-open = false; root.focus-name(); } }
                }
            }
        }
    }
    // `visible:` rather than `if`, so `focus-picker-filter` can reach the LineEdit id.
    Rectangle { visible: root.picker-open; background: #0005; TouchArea { }
        Rectangle { x: 24px; y: 48px; width: parent.width - 48px; height: parent.height - 96px; background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.stroke;
            VerticalLayout { padding: 14px; spacing: 10px;
                Text { text: "选择已安装应用"; font-size: 16px; font-weight: 600; color: Palette.foreground; }
                picker-filter-input := LineEdit { text <=> root.picker-filter; placeholder-text: "按名称筛选"; accessible-label: "按名称筛选"; changed text => { root.picker-refilter(); } }
                ListView { vertical-stretch: 1;
                    for option in root.picker-shown: Rectangle {
                        height: 46px;
                        Rectangle {
                            y: 2px; width: parent.width; height: 44px; border-radius: 6px;
                            background: option.aumid == root.picker-aumid ? Theme.selection : app-hit.has-hover ? Theme.navigation : transparent;
                            accessible-role: button; accessible-label: option.name;
                            accessible-action-default => { root.picker-aumid = option.aumid; root.picker-name = option.name; }
                            VerticalLayout { padding-left: 8px; spacing: 0px; alignment: center;
                                Text { text: option.name; color: Palette.foreground; overflow: elide; }
                                Text { text: option.aumid; color: Palette.alternate-foreground; font-size: 11px; overflow: elide; }
                            }
                            app-hit := TouchArea {
                                clicked => { root.picker-aumid = option.aumid; root.picker-name = option.name; }
                                double-clicked => { root.picker-confirm(option.aumid, option.name); }
                            }
                            Tooltip { HintSurface { title: option.aumid; } }
                        }
                    }
                }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: "取消"; clicked => { root.picker-open = false; root.focus-name(); } }
                    Button { text: "添加"; enabled: root.picker-aumid != ""; clicked => { root.picker-confirm(root.picker-aumid, root.picker-name); } }
                }
            }
        }
    }

}

export component SettingsWindow inherits AppWindow {
    in property <string> rust-version;
    in property <bool> composing;
    in-out property <bool> window-active <=> root.frame-active;
    title: "设置 · Diascia";
    preferred-width: 660px; preferred-height: 480px;
    min-width: 580px; min-height: 400px;
    in-out property <string> hotkey-text: "Ctrl+Alt+Space";
    in-out property <bool> recording-hotkey;
    in-out property <string> hotkey-error;
    callback record-hotkey; callback reset-hotkey; callback captured-hotkey(string);
    in-out property <int> page;
    in-out property <bool> autostart;
    in-out property <bool> double-click;
    in-out property <bool> edge-hide;
    in-out property <bool> edge-strip-visible: true;
    in-out property <int> edge-strip-width: 1;
    in-out property <bool> hide-on-focus-loss;
    in-out property <bool> hover-switch;
    in-out property <int> hover-delay: 350;
    in-out property <bool> relative-paths;
    in-out property <bool> hide-after-launch;
    in-out property <bool> fullscreen-protection;
    in-out property <bool> protection-log;
    in-out property <bool> protection-bypass;
    callback protection-bypass-changed(bool);
    in-out property <bool> keep-topmost;
    in-out property <[string]> protected-apps;
    in-out property <string> protected-input;
    in-out property <string> protected-error;
    in property <string> data-path;
    in-out property <string> status;
    in-out property <bool> restore-confirm;
    callback open-rust; callback change(int); callback browse-game; callback add-protected-app(string); callback remove-protected-app(int); callback export-data; callback import-data;
    callback confirm-restore; callback cancel;
    VerticalLayout {
        padding: 1px; spacing: 0px;
        TitleBar { title: "设置"; close => { root.cancel(); } }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 132px; background: Theme.navigation;
                VerticalLayout { padding: 12px; spacing: 6px; alignment: start;
                    for name[index] in ["常规", "呼出与隐藏", "游戏勿扰", "数据", "关于"]: Rectangle {
                        height: 38px; border-radius: 6px; background: root.page == index ? Theme.selection : nav-touch.has-hover ? Theme.surface : transparent;
                        accessible-role: button; accessible-label: name; accessible-action-default => { root.page = index; }
                        if root.page == index: Rectangle { x: 0px; y: 10px; height: 18px; width: 3px; border-radius: 2px; background: Palette.accent-background; }
                        Text { text: name; x: 12px; width: parent.width - 24px; height: parent.height; vertical-alignment: center; color: root.page == index ? Palette.accent-background : Palette.foreground; }
                        FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.page = index; return accept; } return reject; } }
                        nav-touch := TouchArea { clicked => { root.page = index; } }
                    }
                }
            }
            Rectangle { background: Theme.surface;
                VerticalLayout {
                    padding: 16px; spacing: 8px;
                    ScrollView {
                        content-width: self.visible-width;
                        VerticalLayout { spacing: 2px; padding-right: 4px; alignment: start;
if root.page == 0: SettingRow { label: "开机启动"; Switch { height: 32px; checked <=> root.autostart; toggled => { root.change(0); } } }
if root.page == 0: SettingRow { label: "打开项目后隐藏"; Switch { height: 32px; checked <=> root.hide-after-launch; toggled => { root.change(0); } } }

                            if root.page == 0: SettingRow { label: "启动方式"; ComboBox { width: 150px; height: 32px; model: ["单击", "双击"]; current-index: root.double-click ? 1 : 0; selected(value) => { root.double-click = self.current-index == 1; root.change(0); } } }
                            if root.page == 0: SettingRow { label: "悬停切换分类"; Switch { height: 32px; checked <=> root.hover-switch; toggled => { root.change(0); } } }
                            if root.page == 0 && root.hover-switch: SettingRow { label: "悬停延迟"; ComboBox { width: 150px; height: 32px; model: ["200 ms", "350 ms", "600 ms"]; current-index: root.hover-delay == 200 ? 0 : root.hover-delay == 600 ? 2 : 1; selected(value) => { root.hover-delay = self.current-index == 0 ? 200 : self.current-index == 2 ? 600 : 350; root.change(0); } } }
                            if root.page == 1: SettingRow { label: "呼出热键"; control-width: 284px;
                                Button { width: 200px; text: root.recording-hotkey ? "请按组合键 · Esc 取消" : root.hotkey-text; clicked => { root.record-hotkey(); } }
                                Button { width: 76px; text: "恢复默认"; clicked => { root.reset-hotkey(); } }
                            }
                            if root.page == 1 && root.hotkey-error != "": Text { text: root.hotkey-error; wrap: word-wrap; color: Palette.foreground; }
                            if root.page == 1: SettingRow { label: "贴边自动收纳"; Switch { height: 32px; checked <=> root.edge-hide; toggled => { root.change(0); } } }
                            if root.page == 1: SettingRow { label: "窗口始终置顶"; Switch { height: 32px; checked <=> root.keep-topmost; toggled => { root.change(3); } } }
                            if root.page == 1: SettingRow { label: "显示露边"; enabled: root.edge-hide; Switch { height: 32px; enabled: root.edge-hide; checked <=> root.edge-strip-visible; toggled => { root.change(0); } } }
                            if root.page == 1: SettingRow { label: "露边宽度"; control-width: 216px; enabled: root.edge-hide && root.edge-strip-visible;
                                Slider { enabled: root.edge-hide && root.edge-strip-visible; width: 100px; height: 32px; minimum: 1; maximum: 12; value: root.edge-strip-width; changed(value) => { root.edge-strip-width = round(value); root.change(0); } }
                                HorizontalLayout { width: 108px; height: 32px; spacing: 2px;
                                    Button { width: 28px; text: "−"; enabled: root.edge-hide && root.edge-strip-visible && root.edge-strip-width > 1; clicked => { root.edge-strip-width -= 1; root.change(0); } }
                                    PixelWidthInput { value <=> root.edge-strip-width; enabled: root.edge-hide && root.edge-strip-visible; edited => { root.change(0); } }
                                    Button { width: 28px; text: "+"; enabled: root.edge-hide && root.edge-strip-visible && root.edge-strip-width < 12; clicked => { root.edge-strip-width += 1; root.change(0); } }
                                }
                            }
                            if root.page == 1: Text { text: "宽度单位为物理像素。关闭露边后，仍可悬停原位置的屏幕边缘展开。"; wrap: word-wrap; color: Palette.alternate-foreground; font-size: 12px; }
                            if root.page == 1: SettingRow { label: "失去焦点时隐藏"; Switch { height: 32px; checked <=> root.hide-on-focus-loss; toggled => { root.change(0); } } }
                            if root.page == 2: SettingRow { label: "全屏保护"; Switch { height: 32px; checked <=> root.fullscreen-protection; toggled => { root.change(0); } } }
                            if root.page == 2: SettingRow { label: "暂停游戏勿扰"; Switch { height: 32px; checked: root.protection-bypass; toggled => { root.protection-bypass-changed(!root.protection-bypass); } } }
                            if root.page == 2: Text { text: "仅本次运行有效：暂停期间热键、托盘和贴边呼出恢复可用，退出后自动回到判定状态。"; wrap: word-wrap; color: Palette.alternate-foreground; font-size: 12px; }
                            if root.page == 2: SettingRow { label: "记录保护判定"; Switch { height: 32px; checked <=> root.protection-log; toggled => { root.change(0); } } }
                            if root.page == 2: Text { text: "记录前台应用、通知状态与被阻止的呼出请求，用于排查游戏全屏时的干扰；文件保存在数据目录，含本地路径，分享前请先自行检查。"; wrap: word-wrap; color: Palette.alternate-foreground; font-size: 12px; }
                            if root.page == 2: VerticalLayout { spacing: 12px;
                                Text { text: "严格保护程序"; color: Palette.foreground; }
                                HorizontalLayout { spacing: 8px;
                                    LineEdit { text <=> root.protected-input; placeholder-text: "输入程序完整路径"; horizontal-stretch: 1;
                                        accessible-label: "严格保护程序路径";
                                        accepted(text) => { if !root.composing { root.add-protected-app(text); } } }
                                    Button { text: "添加"; clicked => { root.add-protected-app(root.protected-input); } }
                                    IconButton { icon: @image-url("icons/folder.svg"); label: "选择游戏程序"; clicked => { root.browse-game(); } }
                                }
                                if root.protected-apps.length == 0: Text { text: "尚未添加严格保护的程序。"; color: Palette.alternate-foreground; font-size: 12px; }
                                VerticalLayout { spacing: 2px; alignment: start;
                                    for path[index] in root.protected-apps: Rectangle { height: 32px; border-radius: 4px;
                                        background: protected-row-touch.has-hover ? Theme.navigation : transparent;
                                        protected-row-touch := TouchArea { }
                                        Text { x: 10px; width: parent.width - 50px; height: parent.height; text: path; vertical-alignment: center; overflow: elide; color: Palette.foreground; }
                                        IconButton { icon: @image-url("icons/close.svg"); label: "移除 " + path; x: parent.width - 38px; y: 0px; width: 32px; height: 32px; clicked => { root.remove-protected-app(index); } }
                                        Tooltip { HintSurface { title: path; } }
                                    }
                                }
                                Text { text: "最多 100 项；前台窗口命中任一路径即进入严格保护。"; wrap: word-wrap; color: Palette.alternate-foreground; font-size: 12px; }
                            }
                            if root.page == 2 && root.protected-error != "": Text { text:root.protected-error; wrap:word-wrap; color:Palette.foreground; }
                            if root.page == 3: VerticalLayout { spacing: 12px;
                                Text { text: "数据目录"; font-weight: 600; color: Palette.foreground; }
                                Text { text: root.data-path; wrap: word-wrap; color: Palette.alternate-foreground; }
                                SettingRow { label: "新增项目优先使用相对路径"; Switch { height: 32px; checked <=> root.relative-paths; toggled => { root.change(0); } } }
                                HorizontalLayout { spacing: 8px; alignment: start;
                                    Button { text: "导出"; clicked => { root.export-data(); } }
                                    Button { text: "恢复"; clicked => { root.import-data(); } }
                                }
                                if root.restore-confirm: VerticalLayout { spacing: 12px;
                                    Text { text: "替换当前数据？请先自行备份数据目录。"; wrap: word-wrap; color: Palette.foreground; }
                                    HorizontalLayout { Button { text: "恢复"; clicked => { root.confirm-restore(); } } Button { text: "取消"; clicked => { root.restore-confirm = false; } } }
                                }
                            }
                            if root.page == 4: VerticalLayout { spacing: 14px; alignment: start;
                                HorizontalLayout { spacing: 12px; alignment: start;
                                    Image { width: 40px; height: 40px; source: @image-url("icons/app.svg"); colorize: Palette.accent-background; }
                                    VerticalLayout { spacing: 4px;
                                        Text { text: "Diascia"; font-size: 22px; font-weight: 600; color: Palette.foreground; }
                                        Text { text: "Version 0.0.0"; color: Palette.alternate-foreground; }
                                    }
                                }
                                Rectangle { height: 20px; }
                                HorizontalLayout { spacing: 20px;
                                    Rectangle { horizontal-stretch: 1; height: 118px; background: transparent;
                                        VerticalLayout { padding: 10px; spacing: 6px; alignment: center;
                                            HorizontalLayout { alignment: center; Image { width: 44px; height: 44px; source: @image-url("icons/rust.svg"); colorize: Palette.foreground; } }
                                            Text { text: "Version " + root.rust-version; horizontal-alignment: center; font-weight: 600; color: Palette.foreground; }
                                            Text { text: "https://www.rust-lang.org/"; horizontal-alignment: center; font-size: 12px; color: Palette.alternate-foreground; }
                                        }
                                        accessible-role: button; accessible-label: "Rust 官网"; accessible-action-default => { root.open-rust(); }
                                        FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.open-rust(); return accept; } return reject; } }
                                        rust-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-rust(); } }
                                        Tooltip { HintSurface { title: "https://www.rust-lang.org/"; } }
                                    }
                                    AboutSlint { horizontal-stretch: 1; height: 118px; }
                                }
                            }
                            if root.status != "": Text { text: root.status; wrap: word-wrap; color: Palette.foreground; }
                        }
                    }
                }
            }
        }
    }
}

